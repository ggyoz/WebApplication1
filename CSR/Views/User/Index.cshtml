@model CSR.Models.UserIndexViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer

@{
    ViewData["Title"] = Localizer["UserManagement"];
}

<partial name="_PageTitlePartial" />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<div class="search-area card">
    <div class="search-body">
        <form asp-action="Index" method="get">
            <table class="table table-bordered">
                <tbody>
                    <colgroup>
                        <col width="8%"></col>
                        <col width="15%"></col>
                        <col width="8%"></col>
                        <col width="15%"></col>
                        <col width="8%"></col>
                        <col width="15%"></col>
                        <col width="8%"></col>
                        <col width="15%"></col>
                    </colgroup>                    

                    <tr>
                        <th>@SharedLocalizer["Label_Corporation"]</th>
                        <td>
                            <select id="CorCd" asp-items="ViewBag.CorCdList" class="form-select" name="CorCd">
                                <option value="">@SharedLocalizer["Placeholder_SelectCorporation"]</option>
                            </select>
                        </td>
                        <th>@SharedLocalizer["Label_Department"]</th>
                        <td>
                            <select id="DeptCd" asp-items="ViewBag.DeptCdList"  class="form-select" name="DeptCd">
                                <option value="">@SharedLocalizer["Placeholder_SelectDepartment"]</option>
                            </select>
                        </td>
                        <th>@SharedLocalizer["Label_Office"]</th>
                        <td>
                            <select id="OfficeCd" asp-items="ViewBag.OfficeCdList" class="form-select" name="OfficeCd">
                                <option value="">@SharedLocalizer["Placeholder_SelectOffice"]</option>
                            </select>
                        </td>
                        <th>@SharedLocalizer["Label_Team"]</th>
                        <td>
                            <select id="TeamCd" asp-items="ViewBag.TeamCdList" class="form-select" name="TeamCd">
                                <option value="">@SharedLocalizer["Placeholder_SelectTeam"]</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="align-middle text-center">@SharedLocalizer["Label_UserId"]</th>
                        <!-- <td><input asp-for="Search.UserId" class="form-control" /></td> -->
                        <td><input name="UserId" class="form-control" value="@Model.Search.UserId" /></td>
                        <th class="align-middle text-center">@SharedLocalizer["Label_UserName"]</th>
                        <td><input name="UserName" class="form-control" value="@Model.Search.UserName" /></td> 
                        <td colspan="4" class="text-end">
                            <button type="submit" class="btn btn-light search-btn">@Localizer["Search"]</button>
                        </td>
                    </tr>
                    
                </tbody>
            </table> 
            
        </form>
    </div>
</div>


<div class="d-flex justify-content-between mb-3 align-items-center">
    <div>
        @if (Model.Users.TotalCount > 0)
        {
            <p class="text-muted mb-0">@Localizer["TotalUsers", Model.Users.TotalCount]</p>
        }
    </div>
    <div>
        <a asp-action="Create" class="btn btn-add">@Localizer["AddUser"]</a>
    </div>
</div>


@if (Model.Users.Items != null && Model.Users.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <colgroup>
                    <col width="8%"/>
                    <col width="8%"/>
                    <col width="8%"/>
                    <col width="8%"/>
                    <col width="8%"/>
                    
                    <col width="8%"/>
                    <col width="15%"/>
                    <col width="8%"/>
                    <col width="8%"/>
                    <col width="8%"/>
                </colgroup>
                <tr>
                    <th>@SharedLocalizer["TableHeader_UserId"]</th>
                    <th>@SharedLocalizer["TableHeader_UserName"]</th>
                    <th>@SharedLocalizer["TableHeader_CorperationCode"]</th>
                    <th>@SharedLocalizer["TableHeader_DepartmentCode"]</th>
                    <th>@SharedLocalizer["TableHeader_OfficeCode"]</th>
                    
                    <th>@SharedLocalizer["TableHeader_TeamCode"]</th>
                    <th>@SharedLocalizer["TableHeader_Email"]</th>
                    <th>@SharedLocalizer["TableHeader_InUse"]</th>
                    <th>@SharedLocalizer["사용자권한"]</th>                    
                    <th>@Localizer["Operation"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users.Items)
                {
                    @await Html.PartialAsync("_UserRow", user)
                }
            </tbody>
        </table>
    </div>

    <partial name="_PagingPartial" model="Model.Users" />
}
else
{
    <p class="text-muted">@Localizer["NoUsersToDisplay"]</p>
}

@section Scripts {    
    <!-- <partial name="_OrganizationFieldsPartial.Scripts" /> -->

    <style>
        .table-bordered th {
            display :flex;
            justify-content: center; /* Horizontally centers content */
            align-items: center;     /* Vertically centers content */
        }        
    </style>

    <script>

        $(function () {     

            const searchValues = {
                CorCd: '@ViewData["CorCd"]',
                DeptCd: '@ViewData["DeptCd"]',
                OfficeCd: '@ViewData["OfficeCd"]',
                TeamCd: '@ViewData["TeamCd"]'
            };            
            
            if (searchValues.CorCd) {
                $('select[name="CorCd"]').val(searchValues.CorCd);
            }
            if (searchValues.DeptCd) {
                $('select[name="DeptCd"]').val(searchValues.DeptCd);
            }
            if (searchValues.OfficeCd) {
                $('select[name="OfficeCd"]').val(searchValues.OfficeCd);
            }
            if (searchValues.TeamCd) {
                $('select[name="TeamCd"]').val(searchValues.TeamCd);
            }

            // 법인 선택 시 메뉴 드롭다운 변경
            $('#CorCd').on('change', function() {
                var corCd = $(this).val();
                var deptDropdown = $('#DeptCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectDepartment"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd: corCd, deptCd : "" },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // 법인 선택 시 메뉴 드롭다운 변경
            $('#DeptCd').on('change', function() {
                var deptCd = $(this).val();
                var corCd = $('#CorCd').val();

                var deptDropdown = $('#OfficeCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectOffice"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd : corCd, deptCd: deptCd },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });
            
            // 법인 선택 시 메뉴 드롭다운 변경
            $('#OfficeCd').on('change', function() {
                var deptCd = $(this).val();
                var corCd = $('#CorCd').val();

                var deptDropdown = $('#TeamCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectTeam"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd : corCd, deptCd: deptCd },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

        });
    </script>

}
