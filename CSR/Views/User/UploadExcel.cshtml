@model List<CSR.Models.User>
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer
@{
    ViewData["Title"] = "유저 엑셀 업로드";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Button_List"]</a>
    </div>
    <hr />

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="UploadExcel" method="post" enctype="multipart/form-data" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="file" class="col-form-label">엑셀 파일 선택:</label>
                </div>
                <div class="col-md-4">
                    <input type="file" name="file" id="file" class="form-control" accept=".xlsx, .xls" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-file-earmark-arrow-up"></i> 엑셀 불러오기
                    </button>
                </div>
                <div class="col-auto ms-auto">
                    <div class="text-muted small">
                        * 형식: ID, 성명, 사번, 이메일, 연락처, 법인코드, 부서코드, 사무실코드, 팀코드, 구분
                    </div>
                </div>
            </form>
            <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">업로드 대기 목록 (@Model.Count 건)</h5>
                <div>
                    <button type="button" class="btn btn-success btn-sm" id="btnSaveData">
                        <i class="bi bi-check-circle"></i> 일괄 저장/업데이트
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>@SharedLocalizer["Label_UserId"]</th>
                                <th>@SharedLocalizer["Label_UserName"]</th>
                                <th>@SharedLocalizer["Label_EmployeeNo"]</th>
                                <th>@SharedLocalizer["Label_TelNumber"]</th>
                                <th>@SharedLocalizer["Label_PhoneNumber"]</th>
                                <th>@SharedLocalizer["Label_EmailAddress"]</th>
                                <th>@SharedLocalizer["Label_Corporation"]</th>
                                <th>@SharedLocalizer["Label_Corporation"]</th>
                                <th>@SharedLocalizer["Label_Department"]</th>
                                <th>@SharedLocalizer["Label_Office"]</th>
                                <th>@SharedLocalizer["Label_Team"]</th>
                                <th>@SharedLocalizer["Label_UserDivision"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.UserId</td>
                                    <td>@user.UserName</td>
                                    <td>@user.EmpNo</td>
                                    <td>@user.TelNo</td>
                                    <td>@user.MobPhoneNo</td>
                                    <td>@user.EmailAddr</td>
                                    <td>@user.CorpName</td>
                                    <td>@user.CorCd</td>
                                    <td>@user.DeptCd</td>
                                    <td>@user.OfficeCd</td>
                                    <td>@user.TeamCd</td>
                                    <td>@user.UserDiv</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (ViewContext.HttpContext.Request.Method == "POST")
    {
        <div class="alert alert-info mt-3">
            업로드된 데이터가 없거나 형식이 올바르지 않습니다.
        </div>
    }
</div>

@section Scripts {
    <script>
        $(function() {
            // Anti-Forgery Token 가져오기
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            $('#btnSaveData').on('click', function() {
                // Razor 모델을 JS 객체로 직렬화
                const userData = @Html.Raw(Json.Serialize(Model));
                
                if (!userData || userData.length === 0) {
                    alert("저장할 데이터가 없습니다.");
                    return;
                }

                if (!confirm(userData.length + "건의 데이터를 DB에 반영하시겠습니까?\n이미 존재하는 ID는 정보가 업데이트됩니다.")) {
                    return;
                }

                const $btn = $(this);
                const originalHtml = $btn.html();
                
                // 버튼 비활성화 및 로딩 표시
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> 저장 중...');

                $.ajax({
                    url: '@Url.Action("SaveExcelData", "User")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(userData),
                    headers: {
                        'RequestVerificationToken': antiForgeryToken
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.href = '@Url.Action("Index", "User")';
                        } else {
                            alert("오류 발생: " + response.message);
                            $btn.prop('disabled', false).html(originalHtml);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error(xhr.responseText);
                        alert("서버 통신 중 오류가 발생했습니다.");
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });
        });
    </script>
}
