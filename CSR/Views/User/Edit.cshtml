@model CSR.Models.User
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<partial name="_PageTitlePartial" />

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="RegDate" />
            <input type="hidden" asp-for="RegUserId" />

            <table class="table-layout" width="100%">

                <colgroup>
                    <col width="5%"></col>
                    <col width="10%"></col>
                    <col width="5%"></col>
                    <col width="10%"></col>
                    <col width="5%"></col>
                    <col width="10%"></col>                        
                    <col width="5%"></col>
                    <col width="10%"></col>
                </colgroup>
                <tr>
                    <td><label asp-for="UserId" class="control-label">@SharedLocalizer["Label_UserId"] *</label></td>
                    <td>
                        <input asp-for="UserId" class="form-control" readonly />
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </td>                    
                </tr>
                <tr>
                    <td><label asp-for="UserPwd" class="control-label">@SharedLocalizer["Label_Password"] *</label></td>
                    <td>
                        <input asp-for="UserPwd" class="form-control" type="password" placeholder="@Localizer["Placeholder_Password"]" />
                        <span asp-validation-for="UserPwd" class="text-danger"></span>
                    </td>
                    <td></td><td></td><td></td><td></td>
                </tr>

                <tr>
                    <td><label asp-for="UserName" class="control-label">@SharedLocalizer["Label_UserName"] *</label></td>
                    <td>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </td>
                    <td><label asp-for="EmpNo" class="control-label">@SharedLocalizer["Label_EmployeeNo"] </label></td>
                    <td>
                        <input asp-for="EmpNo" class="form-control" oninput="this.value = NumberOnly(this.value)" maxlength=9  />
                        <span asp-validation-for="EmpNo" class="text-danger"></span>
                    </td>
                </tr>                
                <tr>
                    <td>@SharedLocalizer["Label_Corporation"]</td>
                    <td>
                        <select asp-for="CorCd" id="CorCd" asp-items="ViewBag.CorCdList" class="form-select" name="CorCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectCorporation"]</option>
                        </select>
                    </td>
                    <td>@SharedLocalizer["Label_Department"]</td>
                    <td>
                        <select asp-for="DeptCd" id="DeptCd" asp-items="ViewBag.DeptCdList"  class="form-select" name="DeptCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectDepartment"]</option>
                        </select>
                    </td>
                    <td>@SharedLocalizer["Label_Office"]</td>
                    <td>
                        <select asp-for="OfficeCd" id="OfficeCd" asp-items="ViewBag.OfficeCdList" class="form-select" name="OfficeCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectOffice"]</option>
                        </select>
                    </td>
                    <td>@SharedLocalizer["Label_Team"]</td>
                    <td>
                        <select asp-for="TeamCd" id="TeamCd" asp-items="ViewBag.TeamCdList" class="form-select" name="TeamCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectTeam"]</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="SysCd" class="control-label">@SharedLocalizer["Label_SystemCode"]</label></td>
                    <td>
                        <input asp-for="SysCd" class="form-control" />
                        <span asp-validation-for="SysCd" class="text-danger"></span>
                    </td>
                    <td><label asp-for="BizCd" class="control-label">@SharedLocalizer["Label_BusinessPlaceCode"]</label></td>
                    <td>
                        <input asp-for="BizCd" class="form-control" />
                        <span asp-validation-for="BizCd" class="text-danger"></span>
                    </td>
                    <td><label asp-for="CustCd" class="control-label">@SharedLocalizer["Label_CustomerCode"]</label></td>
                    <td>
                        <input asp-for="CustCd" class="form-control" />
                        <span asp-validation-for="CustCd" class="text-danger"></span>
                    </td>
                    <td><label asp-for="VendCd" class="control-label">@SharedLocalizer["Label_VendorCode"]</label></td>
                    <td>
                        <input asp-for="VendCd" class="form-control" />
                        <span asp-validation-for="VendCd" class="text-danger"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="TelNo" class="control-label">@SharedLocalizer["Label_PhoneNumber"]</label></td>
                    <td>
                        <input asp-for="TelNo" class="form-control" oninput="this.value=formatPhoneNumber(this.value)" maxlength="13" />
                        <!-- <span asp-validation-for="TelNo" class="text-danger"></span> -->
                    </td>
                    <td><label asp-for="MobPhoneNo" class="control-label">@SharedLocalizer["Label_MobilePhoneNumber"]</label></td>
                    <td>
                        <input asp-for="MobPhoneNo" class="form-control" oninput="this.value=formatPhoneNumber(this.value)" maxlength="13" />
                        <!-- <span asp-validation-for="MobPhoneNo" class="text-danger"></span> -->
                    </td>
                    <td><label asp-for="EmailAddr" class="control-label">@SharedLocalizer["Label_EmailAddress"]</label></td>
                    <td>
                        <input asp-for="EmailAddr" class="form-control" type="email" />
                        <span asp-validation-for="EmailAddr" class="text-danger"></span>
                    </td>
                    <td><label asp-for="RetireDate" class="control-label">@SharedLocalizer["Label_RetirementDate"]</label></td>
                    <td>
                        <div id="RetireDate"></div>
                        <!-- <span asp-validation-for="RetireDate" class="text-danger"></span> -->
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="UserDiv" class="control-label">@SharedLocalizer["Label_UserDivision"]</label></td>
                    <td>
                        <select asp-for="UserDiv" class="form-select">
                            <option value="R1">R1</option>
                            <option value="R2">R2</option>
                            <option value="R3">R3</option>
                            <option value="R4">R4</option>
                        </select>                        
                        <span asp-validation-for="UserDiv" class="text-danger"></span>
                    </td>
                    <td><label asp-for="UserStat" class="control-label">@SharedLocalizer["Label_UserStat"]</label></td>
                    <td>
                        <input asp-for="UserStat" class="form-control" />
                        <span asp-validation-for="UserStat" class="text-danger"></span>
                    </td>
                    <td><label asp-for="UseYn" class="control-label">@SharedLocalizer["Label_InUse"]</label></td>
                    <td>
                        <select asp-for="UseYn" class="form-select">
                            <option value="Y">Y</option>
                            <option value="N">N</option>
                        </select>
                        <span asp-validation-for="UseYn" class="text-danger"></span>
                    </td>
                    <td><label asp-for="PwMissCount" class="control-label">@SharedLocalizer["Label_PasswordFailCount"]</label></td>
                    <td>
                        <input asp-for="PwMissCount" class="form-control" type="number" />
                        <span asp-validation-for="PwMissCount" class="text-danger"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="AdminFlag" class="control-label">@SharedLocalizer["Label_AdminPrivileges"]</label></td>
                    <td>
                        <div class="form-check">
                            <input asp-for="AdminFlag" class="form-check-input" type="checkbox" />
                        </div>
                        <span asp-validation-for="AdminFlag" class="text-danger"></span>
                    </td>
                    <!-- <td><label asp-for="AuthFlag" class="control-label">@SharedLocalizer["Label_Authorization"]</label></td>
                    <td>
                        <div class="form-check">
                            <input asp-for="AuthFlag" class="form-check-input" type="checkbox" value="1" />
                        </div>
                        <span asp-validation-for="AuthFlag" class="text-danger"></span>
                    </td> -->
                    <td></td><td></td><td></td><td></td>
                </tr>
                <tr>
                    <td><strong>담당영역</strong></td>
                    <td colspan="7">
                        @{
                            var allResponsibilities = ViewBag.AllResponsibilities as Dictionary<string, List<CSR.Models.CommCode>> ?? new Dictionary<string, List<CSR.Models.CommCode>>();
                        }
                        @foreach (var group in allResponsibilities)
                        {
                            <div class="mb-2">
                                <strong>@group.Key</strong>
                                <div class="d-flex flex-wrap mt-1">
                                @foreach (var responsibility in group.Value)
                                {
                                    <div class="form-check me-3">
                                        <input class="form-check-input" type="checkbox" name="AssignedResponsibilities" value="@responsibility.CODEID" id="resp_@responsibility.CODEID"
                                            @(Model.AssignedResponsibilities.Contains(responsibility.CODEID.ToString()) ? "checked" : "") />
                                        <label class="form-check-label" for="resp_@responsibility.CODEID">
                                            @responsibility.CODENM
                                        </label>
                                    </div>
                                }
                                </div>
                            </div>
                        }
                    </td>
                </tr>                 
            </table>

            <div class="button-area text-end mt-5 m-3">
                <input type="submit" value="@SharedLocalizer["Button_Save"]" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn btn-list">@SharedLocalizer["Button_List"]</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- <partial name="_OrganizationFieldsPartial.Scripts" /> -->
    <script>

    // const labelMode = 'static';

    // const today = Date.now();

    const birthDate = $('#RetireDate').dxDateBox({
        placeholder: '퇴사일 입력',
        inputAttr: { 'aria-label': 'Retire Date' },
        labelMode,
    }).dxDateBox('instance');
        
    $(function () {     

            var DeptCdVal = @Html.Raw(Json.Serialize(Model.DeptCd));
            var OfficeCdVal = @Html.Raw(Json.Serialize(Model.OfficeCd));
            var TeamCdVal = @Html.Raw(Json.Serialize(Model.TeamCd));

        // 법인 선택 시 메뉴 드롭다운 변경
            $('#CorCd').on('change', function() {
                var corCd = $(this).val();
                var deptDropdown = $('#DeptCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectDepartment"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd: corCd, deptCd : "" },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // 법인 선택 시 메뉴 드롭다운 변경
            $('#DeptCd').on('change', function() {
                var deptCd = $(this).val();
                var corCd = $('#CorCd').val();

                var deptDropdown = $('#OfficeCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectOffice"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd : corCd, deptCd: deptCd },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });
            
            // 법인 선택 시 메뉴 드롭다운 변경
            $('#OfficeCd').on('change', function() {
                var deptCd = $(this).val();
                var corCd = $('#CorCd').val();

                var deptDropdown = $('#TeamCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectTeam"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd : corCd, deptCd: deptCd },
                        success: function(data) {                            
                            $.each(data, function(i, item) {
                                
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

    });


    </script>

}
