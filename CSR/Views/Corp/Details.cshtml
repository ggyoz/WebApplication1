@model CSR.Models.Corp

@{
    ViewData["Title"] = "법인 상세 정보";
}

<partial name="_PageTitlePartial" />

<div class="card">
    <div class="card-body">
        <table class="table table-layout table-bordered detail-table mb-0">
            <colgroup>
                <col style="width: 15%; background-color: #f8f9fa;" />
                <col style="width: 35%;" />
                <col style="width: 15%; background-color: #f8f9fa;" />
                <col style="width: 35%;" />
            </colgroup>
            <tbody>
                <tr>
                    <th class="text-center">@Html.DisplayNameFor(model => model.CorCd)</th>
                    <td>@Model.CorCd</td>
                    <th class="text-center">@Html.DisplayNameFor(model => model.CorNm)</th>
                    <td>@Model.CorNm</td>
                </tr>
                <tr>
                    <th class="text-center">@Html.DisplayNameFor(model => model.NationCd)</th>
                    <td>@Model.NationCd</td>
                    <th class="text-center">@Html.DisplayNameFor(model => model.CoinCd)</th>
                    <td>@Model.CoinCd</td>
                </tr>
                <tr>
                    <th class="text-center">@Html.DisplayNameFor(model => model.Language)</th>
                    <td>@Model.Language</td>
                    <th class="text-center">@Html.DisplayNameFor(model => model.AccTitle)</th>
                    <td>@Model.AccTitle</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="button-area mt-3 d-flex justify-content-start gap-2">
    <a asp-action="Edit" asp-route-id="@Model.CorCd" class="btn btn-primary">수정</a>
    <a asp-action="Index" class="btn btn-secondary">목록으로</a>
</div>

<style>
    .detail-table th {
        font-weight: 600;
        vertical-align: middle;
        background-color: #f8f9fa;
    }
    .detail-table td {
        vertical-align: middle;
    }
</style>
