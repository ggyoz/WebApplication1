@{
    ViewData["Title"] = "이메일 전송 테스트";
}

<div class="container mt-5">
    <h2>이메일 전송 테스트</h2>
    <hr />

    @if (ViewBag.Message != null)
    {
        <div class="alert @(ViewBag.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="SendTestEmail" method="post" class="mb-5">
        <h4>일반 텍스트 메일 전송</h4>
        <div class="mb-3">
            <label for="toEmail" class="form-label">수신자 이메일</label>
            <input type="email" class="form-control" id="toEmail" name="toEmail" required placeholder="example@email.com">
        </div>
        <div class="mb-3">
            <label for="subject" class="form-label">제목</label>
            <input type="text" class="form-control" id="subject" name="subject" required placeholder="테스트 메일 제목">
        </div>
        <div class="mb-3">
            <label for="body" class="form-label">내용</label>
            <textarea class="form-control" id="body" name="body" rows="5" required placeholder="테스트 메일 본문"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">전송</button>
    </form>

    <hr />

    <form asp-action="SendTemplateEmail" method="post" class="mb-5">
        <h4>정석 방식 (Razor 템플릿 메일) 전송</h4>
        <p class="text-muted"><code>Views/Test/SampleEmail.cshtml</code> 템플릿을 사용하여 HTML 메일을 발송합니다.</p>
        <div class="mb-3">
            <label for="toEmail_template" class="form-label">수신자 이메일</label>
            <input type="email" class="form-control" id="toEmail_template" name="toEmail" required placeholder="example@email.com">
        </div>
        <button type="submit" class="btn btn-success">템플릿 메일 전송</button>
    </form>

    <hr />

    <form asp-action="SendRequestToProcessorEmail" method="post" class="mb-5">
        <h4>조치자용 알림 메일 템플릿 테스트</h4>
        <p class="text-muted"><code>Views/EmailTemplates/RequestToProcessor.cshtml</code> 템플릿을 테스트합니다.</p>
        <div class="mb-3">
            <label for="toEmail_processor" class="form-label">수신자 이메일</label>
            <input type="email" class="form-control" id="toEmail_processor" name="toEmail" required placeholder="example@email.com">
        </div>
        <button type="submit" class="btn btn-info text-white">조치자용 메일 테스트 전송</button>
    </form>

    <hr />

    <form asp-action="SendResponseToRequesterEmail" method="post" class="mb-5">
        <h4>요청자용 답변 알림 메일 템플릿 테스트</h4>
        <p class="text-muted"><code>Views/EmailTemplates/ResponseToRequester.cshtml</code> 템플릿을 테스트합니다.</p>
        <div class="mb-3">
            <label for="toEmail_requester" class="form-label">수신자 이메일</label>
            <input type="email" class="form-control" id="toEmail_requester" name="toEmail" required placeholder="example@email.com">
        </div>
        <button type="submit" class="btn btn-warning text-white">요청자용 답변 메일 테스트 전송</button>
    </form>

    <hr />

    <form asp-action="SendProcessorChangedEmail" method="post" class="mb-5">
        <h4>담당자 변경 알림 메일 템플릿 테스트</h4>
        <p class="text-muted"><code>Views/EmailTemplates/ProcessorChanged.cshtml</code> 템플릿을 테스트합니다.</p>
        <div class="mb-3">
            <label for="toEmail_processor_changed" class="form-label">수신자 이메일 (새 담당자)</label>
            <input type="email" class="form-control" id="toEmail_processor_changed" name="toEmail" required placeholder="example@email.com">
        </div>
        <button type="submit" class="btn btn-secondary">담당자 변경 메일 테스트 전송</button>
    </form>
</div>
