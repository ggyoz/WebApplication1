@section Scripts {

    <style>
        .table-bordered th{
            border : 1px solid #dee2e6 !important;
            vertical-align : middle;
            text-align: center;
        }

        .table-bordered tbody{
            border : 1px solid #dee2e6 !important;            
        }

        .table-bordered tr{
            vertical-align : middle;
            text-align: center;
        }

    </style>


    <script>
        $(document).ready(function() {
            // 기준일 (가장 최근의 금요일)을 계산하여 표시
            function setReferenceDate() {
                const today = new Date();
                let dayOfWeek = today.getDay(); // 0 = Sunday, 1 = Monday, ..., 5 = Friday, 6 = Saturday

                // 금요일(5)을 찾기 위해 날짜 조정
                // 만약 오늘이 일요일(0)부터 금요일(5)까지라면, 그 주의 금요일로
                // 만약 오늘이 토요일(6)이라면, 현재 날짜에서 1일 전 (오늘) 금요일로
                let daysToSubtract = 0;
                if (dayOfWeek < 5) { // 일(0), 월(1), 화(2), 수(3), 목(4)
                    daysToSubtract = dayOfWeek + 2; // 예를 들어 월요일(1)이면 1+2=3일 빼서 지난 금요일로
                } else if (dayOfWeek === 6) { // 토요일(6)
                    daysToSubtract = 1; // 1일 빼서 금요일로
                } else { // 금요일(5)
                    daysToSubtract = 0;
                }
                
                const referenceDate = new Date(today);
                referenceDate.setDate(today.getDate() - daysToSubtract);

                const year = referenceDate.getFullYear();
                const month = (referenceDate.getMonth() + 1).toString().padStart(2, '0');
                const day = referenceDate.getDate().toString().padStart(2, '0');

                $('#referenceDate').text(`${year}년 ${month}월 ${day}일`);
            }

            setReferenceDate();

            // 요구사항 전체 건수 조회
            $.ajax({
                url: '/Req/GetAllRequestsCount',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#totalRequestsCount').text(data.count); // 숫자를 로케일에 맞게 포맷
                },
                error: function(xhr, status, error) {
                    console.error("요구사항 전체 건수 조회 실패:", status, error);
                    $('#totalRequestsCount').text('오류');
                }
            });

            // 이번주 추가된 요청 건수 조회
            $.ajax({
                url: '/Req/GetRequestsCountThisWeek',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#thisWeekRequestsCount').text(data.count.toLocaleString());
                },
                error: function(xhr, status, error) {
                    console.error("이번주 추가된 요청 건수 조회 실패:", status, error);
                    $('#thisWeekRequestsCount').text('오류');
                }
            });

            // 사업부서별 긴급도별 요청사항 수 조회 및 테이블 채우기
            $.ajax({
                url: '/Req/GetRequestsCountByDivisionAndPriority',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.stats) {
                        let tableBody = $('#divisionStatsTableBody');
                        tableBody.empty(); // 기존 플레이스홀더 데이터 제거

                        if (response.stats.length === 0) {
                            tableBody.append('<tr><td colspan="4">데이터가 없습니다.</td></tr>');
                        } else {
                            response.stats.forEach(function(item) {
                                console.log(item);
                                tableBody.append(
                                    `<tr>
                                        <th>${item.divisionName}</td>
                                        <td>${item.veryHighCount}</td>
                                        <td>${item.highCount}</td>
                                        <td>${item.mediumCount}</td>
                                        <td>${item.lowCount}</td>
                                        <td>${item.veryLowCount}</td>
                                        <td>${item.totalCount}</td>
                                        <td>${item.ingStatus}</td>
                                        <td>${item.endStatus}</td>
                                        <td>${item.endPercent}%</td>
                                        <td>${item.scheduledCount}</td>
                                        <td>${item.delayedCount}</td>
                                    </tr>`
                                );
                            });
                        }
                    } else {
                        console.error("사업부서별 요청사항 수 조회 실패:", response.message);
                        $('#divisionStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("사업부서별 요청사항 수 조회 실패:", status, error);
                    $('#divisionStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                }
            });

            // 사무실별 긴급도별 요청사항 수 조회 및 테이블 채우기
            $.ajax({
                url: '/Req/GetRequestsCountByOfficeAndPriority',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.stats) {
                        let tableBody = $('#officeStatsTableBody');
                        tableBody.empty(); // 기존 플레이스홀더 데이터 제거

                        if (response.stats.length === 0) {
                            tableBody.append('<tr><td colspan="4">데이터가 없습니다.</td></tr>');
                        } else {
                            response.stats.forEach(function(item) {
                                tableBody.append(
                                    `<tr>
                                        <th>${item.divisionName}</td>
                                        <td>${item.veryHighCount}</td>
                                        <td>${item.highCount}</td>
                                        <td>${item.mediumCount}</td>
                                        <td>${item.lowCount}</td>
                                        <td>${item.veryLowCount}</td>
                                        <td>${item.totalCount}</td>
                                        <td>${item.ingStatus}</td>
                                        <td>${item.endStatus}</td>
                                        <td>${item.endPercent}%</td>
                                    </tr>`
                                );
                            });
                        }
                    } else {
                        console.error("사무실별 요청사항 수 조회 실패:", response.message);
                        $('#officeStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("사무실별 요청사항 수 조회 실패:", status, error);
                    $('#officeStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                }
            });

            // 사무실별 긴급도별 요청사항 수 조회 및 테이블 채우기
            $.ajax({
                url: '/Req/GetRequestsCountByAdminAndPriority',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.stats) {
                        let tableBody = $('#adminStatsTableBody');
                        tableBody.empty(); // 기존 플레이스홀더 데이터 제거

                        if (response.stats.length === 0) {
                            tableBody.append('<tr><td colspan="4">데이터가 없습니다.</td></tr>');
                        } else {
                            response.stats.forEach(function(item) {
                                tableBody.append(
                                    `<tr>
                                        <th>${item.userName}</td>
                                        <td>${item.veryHighCount}</td>
                                        <td>${item.highCount}</td>
                                        <td>${item.mediumCount}</td>
                                        <td>${item.lowCount}</td>
                                        <td>${item.veryLowCount}</td>
                                        <td>${item.totalCount}</td>
                                        <td>${item.ingStatus}</td>
                                        <td>${item.endStatus}</td>
                                        <td>${item.endPercent}%</td>
                                    </tr>`
                                );
                            });
                        }
                    } else {
                        console.error("사무실별 요청사항 수 조회 실패:", response.message);
                        $('#officeStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("사무실별 요청사항 수 조회 실패:", status, error);
                    $('#officeStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                }
            });

            // 이번주 완료예정인 요청 건수 조회
            $.ajax({
                url: '/Req/GetRequestsDueThisWeekCount',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#requestsDueThisWeekCount').text(data.count.toLocaleString());
                },
                error: function(xhr, status, error) {
                    console.error("이번주 완료예정인 요청 건수 조회 실패:", status, error);
                    $('#requestsDueThisWeekCount').text('오류');
                }
            });
        });
    </script>
}
