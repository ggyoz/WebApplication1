    <!-- KPI 카드 영역 (예시) -->

    <div class="row mb-4">
        <div class="col-md-3 mb-4">
            <div class="card blueCard shadow-sm h-100" onClick="goToReqList('', '')">
                <div class="card-body m-3">
                    <div class="d-flex justify-content-between align-items-center" >
                        <div class="d-flex flex-column"> 
                            <h5 class="card-title mb-0">요구사항 전체 건수</h5>
                            <p class="card-text mb-0"></p>
                        </div>
                        <p class="card-text display-5 mb-0" id="totalRequestsCount"></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card greenCard shadow-sm h-100" onClick="goToReqList('', 'thisweek')">
                <div class="card-body m-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex flex-column"> 
                            <h5 class="card-title mb-0">이번주 추가된 요청</h5>
                            <p class="card-text mb-0"></p>
                        </div>
                        <p class="card-text display-5 mb-0" id="thisWeekRequestsCount"></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card yellowCard shadow-sm h-100">
                <div class="card-body m-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex flex-column"> 
                            <h5 class="card-title mb-0">이번주 완료예정</h5>
                            <p class="card-text mb-0"></p>
                        </div>
                        <p class="card-text display-5 mb-0" id="requestsDueThisWeekCount"></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card yellowCard shadow-sm h-100">
                <div class="card-body m-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex flex-column"> 
                            <h5 class="card-title mb-0">전체 진행률</h5>
                            <p class="card-text mb-0"></p>
                        </div>
                        <p class="card-text display-5 mb-0" id="requestsTotalPercent"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 탭 내비게이션 -->
    <ul class="nav nav-tabs mb-4" id="statsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="division-tab" data-bs-toggle="tab" data-bs-target="#division-pane" type="button" role="tab" aria-controls="division-pane" aria-selected="true">사업부</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="office-tab" data-bs-toggle="tab" data-bs-target="#office-pane" type="button" role="tab" aria-controls="office-pane" aria-selected="false">실</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin-pane" type="button" role="tab" aria-controls="admin-pane" aria-selected="false">조치자</button>
        </li>
    </ul>

    <!-- 탭 콘텐츠 -->
    <div class="tab-content" id="statsTabsContent">
        <!-- 사업부서별 탭 -->
        <div class="tab-pane fade show active" id="division-pane" role="tabpanel" aria-labelledby="division-tab" tabindex="0">
            
            <!-- 차트 영역 -->
            <div class="card mb-4">
                <div class="card-header">사업부별 종합 현황</div>
                <div class="card-body">
                    <div id="deptChart" style="height: 300px; border: 1px dashed #ccc; display: flex; justify-content: center; align-items: center;"></div>
                </div>
            </div>

            

            <!-- 테이블 영역 -->
            <div class="card">
                
                <div class="card-header d-flex justify-content-between align-items-center">     
                    <span>사업부별 상세 현황</span> 
                    @* 분기 선택 *@
                    <div class="dx-field">
                        <div id="range-selection"></div>                        
                    </div>                                            
                    <button class="btn btn-sm btn-outline-success" onclick="downloadDivisionExcel()">
                        <i class="bi bi-file-earmark-excel"></i> Excel 다운로드
                    </button>
                    </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped" id="divisionStatsTable"> 
                        <colgroup>
                            <col width="10%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />                            
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="2">조직</th>
                                <th colspan="5">요청사항 수 ( 긴급도 별 )</th>
                                <th colspan="6">진행상태 </th>
                            </tr>
                            <tr>
                                <th>긴급</th>
                                <th>높음</th>
                                <th>보통</th>
                                <th>낮음</th>
                                <th>계</th>
                                <th>진행중</th>
                                <th>종결</th>
                                <th>완료율</th>
                                <th>금주 완료예정</th>
                                <th>현업검증</th>
                                <th>지연</th>
                            </tr>                    
                        </thead>
                        <tbody id="divisionStatsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 사무실별 탭 -->
        <div class="tab-pane fade" id="office-pane" role="tabpanel" aria-labelledby="office-tab" tabindex="0">
            <div class="card">
                <div class="card-header">실별 상세 현황</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <colgroup>
                            <col width="10%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />
                            <col width="8%" />                            
                            <col width="8%" />
                            <col width="8%" />
                        </colgroup>
                        <thead>
                            <tr class="border">
                                <th class="border align-middle text-center" rowspan="2">조직</th>
                                <th class="border align-middle" colspan="5">요청사항 수 ( 긴급도 별 )</th>
                                <th class="border align-middle" colspan="5">진행상태 </th>
                            </tr>
                            <tr>
                                <th>긴급</th>
                                <th>높음</th>
                                <th>보통</th>
                                <th>낮음</th>
                                <th>계</th>
                                <th>진행중</th>
                                <th>종결</th>
                                <th>완료율</th>
                                <th>금주 완료예정</th>
                                <th>지연</th>                        
                            </tr>
                        </thead>
                        <tbody id="officeStatsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 담당자별 탭 -->
        <div class="tab-pane fade" id="admin-pane" role="tabpanel" aria-labelledby="admin-tab" tabindex="0">
            <div class="card">
                <div class="card-header">조치자별 상세 현황</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                            <colgroup>
                                <col width="10%" />
                                <col width="8%" />
                                <col width="8%" />
                                <col width="8%" />
                                <col width="8%" />
                                <col width="8%" />
                                <col width="8%" />
                                <col width="8%" />
                                <col width="8%" />
                            </colgroup>
                        <thead>                            
                            <tr class="border">
                                <th class="border align-middle text-center" rowspan="2">조치자</th>
                                <th class="border align-middle" colspan="5">요청사항 수 ( 긴급도 )</th>
                                <th class="border align-middle" colspan="3">진행상태 </th>
                            </tr>
                            <tr>
                                <th>긴급</th>
                                <th>높음</th>
                                <th>보통</th>
                                <th>낮음</th>                        
                                <th>계</th>
                                <th>진행중</th>
                                <th>종결</th>
                                <th>완료율</th>
                            </tr>
                        </thead>
                        <tbody id="adminStatsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {

    <style>
        .table-bordered th{
            border : 1px solid #dee2e6 !important;
            vertical-align : middle;
            text-align: center;
        }

        .table-bordered tbody{
            border : 1px solid #dee2e6 !important;            
        }

        .table-bordered tr{
            vertical-align : middle;
            text-align: center;
        }
    </style>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>

        function downloadDivisionExcel() {
            const table = document.getElementById('divisionStatsTable');
            const wb = XLSX.utils.table_to_book(table, { sheet: "사업부별 상세 현황", raw: true });
            const fileName = `사업부별_상세_현황_${new Date().toISOString().slice(0, 10)}.xlsx`;
            XLSX.writeFile(wb, fileName);
        }

        const msInDay = 1000 * 60 * 60 * 24;
        const now = new Date();
        const initialValue = getCurrentQuarterRange();

        $(document).ready(function() {
            
            @* 날짜 범위선택 *@
            $('#range-selection').dxDateRangeBox({
                showClearButton: true,
                value: initialValue                
            });

            // 1. 페이지 로드 시 localStorage에서 마지막으로 선택된 탭 ID를 가져옴
            const activeTabId = localStorage.getItem('statisticsActiveTab');
            if (activeTabId) {
                const tabElement = document.getElementById(activeTabId);
                if (tabElement) {
                    // Bootstrap 5 탭 인스턴스를 생성하거나 가져와서 보여줌
                    const tab = new bootstrap.Tab(tabElement);
                    tab.show();
                }
            }

            // 2. 탭 전환 시 localStorage에 현재 탭 ID 저장
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (event) {
                // 현재 선택된 탭의 ID를 저장
                const currentTabId = event.target.id;
                localStorage.setItem('statisticsActiveTab', currentTabId);
    
                // 기존 차트 리렌더링 로직
                if (currentTabId === 'division-tab') {
                    var chartInstance = $('#deptChart').dxChart('instance');
                    if (chartInstance) {
                        chartInstance.render();
                    }
                }
            });

             let dataSource = [];

            $('#deptChart').dxChart({
                dataSource,
                commonSeriesSettings: {
                argumentField: 'state',
                type: 'fullStackedBar',                
                },
                
                series: [
                    { valueField: 'ing', name: '진행중', color: '#696FC7' },
                    { valueField: 'end', name: '종결' , color: '#F2AEBB' },
                    // { valueField: 'older', name: '65 and older' },
                ],
                tooltip: {
                    enabled: true,
                    shared: true,
                    location: 'edge',
                    customizeTooltip(arg) {                        
                        const items = arg.valueText.split('\n');
                        const color = arg.point.getColor();
                        $.each(items, (index, item) => {
                        if (item.indexOf(arg.seriesName) === 0) {
                            items[index] = $('<span>')
                            .text(item)
                            .addClass('active')
                            .css('color', color)
                            .prop('outerHTML');
                        }
                        });
                        return { text: items.join('\n') + '\n' + " : " + Math.round( (arg.value / arg.total) * 1000 ) / 10 + "%" };
                        // return {
                        //     text: `${arg.seriesName} : ${arg.valueText} `,
                        // };
                    },
                },
            });

            setReferenceDate();

            // 카드 요구사항 전체 건수 조회
            $.ajax({
                url: '/api/StatisticsApi/total-count',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#totalRequestsCount').text(data.count); // 숫자를 로케일에 맞게 포맷
                },
                error: function(xhr, status, error) {
                    console.error("요구사항 전체 건수 조회 실패:", status, error);
                    $('#totalRequestsCount').text('오류');
                }
            });

            // 카드 이번주 추가된 요청 건수 조회
            $.ajax({
                url: '/api/StatisticsApi/this-week-count',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#thisWeekRequestsCount').text(data.count.toLocaleString());
                },
                error: function(xhr, status, error) {
                    console.error("이번주 추가된 요청 건수 조회 실패:", status, error);
                    $('#thisWeekRequestsCount').text('오류');
                }
            });

            // 사업부서별 긴급도별 요청사항 수 조회 및 테이블 채우기
            $.ajax({
                url: '/api/StatisticsApi/by-division',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.stats) {                        
                        let tableBody = $('#divisionStatsTableBody');
                        tableBody.empty(); // 기존 플레이스홀더 데이터 제거

                        if (response.stats.length === 0) {
                            tableBody.append('<tr><td colspan="4">데이터가 없습니다.</td></tr>');
                        } else {

                            var chartData = [];

                            // 합게 계산
                            const totals = response.stats.reduce((acc, item) => {
                                    acc.veryHigh += item.veryHighCount;
                                    acc.high += item.highCount;
                                    acc.medium += item.mediumCount;
                                    acc.low += item.lowCount;
                                    acc.total += item.totalCount;
                                    acc.ing += item.ingStatus;
                                    acc.end += item.endStatus;
                                    acc.scheduled += item.scheduledCount;
                                    acc.answered += item.answeredCount;
                                    acc.delayed += item.delayedCount;
                                    return acc;
                                }, { veryHigh: 0, high: 0, medium: 0, low: 0, total: 0, ing: 0, end: 0, scheduled: 0, answered: 0, delayed: 0 });

                                // 2. 행 생성을 위한 헬퍼 함수
                            const createRow = (label, data, isHeader = false) => {
                                const tag = isHeader ? 'strong' : 'span';
                                const thTag = isHeader ? 'th' : 'th'; // 합계 행도 첫 칸은 th 권장
                        
                                return `<tr>
                                    <th>${label}</th>
                                    <td><${tag}>${data.veryHighCount ?? data.veryHigh}</${tag}></td>
                                    <td><${tag}>${data.highCount ?? data.high}</${tag}></td>
                                    <td><${tag}>${data.mediumCount ?? data.medium}</${tag}></td>
                                    <td><${tag}>${data.lowCount ?? data.low}</${tag}></td>
                                    <td style='border-right:1px solid #dee2e6;'><${tag}>${data.totalCount ?? data.total}</${tag}></td>
                                    <td><${tag}>${data.ingStatus ?? data.ing}</${tag}></td>
                                    <td><${tag}>${data.endStatus ?? data.end}</${tag}></td>
                                    <td>${data.endPercent !== undefined ? data.endPercent + '%' : '-'}</td>
                                    <td><${tag}>${data.scheduledCount ?? data.scheduled}</${tag}></td>
                                    <td><${tag}>${data.answeredCount ?? data.answered}</${tag}></td>
                                    <td><${tag}>${data.delayedCount ?? data.delayed}</${tag}></td>
                                </tr>`;
                            };                            
                            
                            //var totalVeryHightCount = 0;
                            //var totalHightCount = 0;
                            //var totalMediumCount = 0;
                            //var totalLowCount = 0;
                            //var totalAnsweredCount = 0;
                            //var totalCount = 0;
                            //var totalScheduledCount = 0;
                            //var totalAnsweredCount = 0;
                            //var totalDelayedCount = 0;
                            //var totalIngStatus = 0;
                            //var totalEndStatus = 0;

                            response.stats.forEach((item) => {
                                tableBody.append(createRow(item.divisionName, item));

                                //tableBody.append(
                                //    `<tr>
                                //        <th>${item.divisionName}</td>
                                //        <td>${item.veryHighCount}</td>
                                //        <td>${item.highCount}</td>
                                //        <td>${item.mediumCount}</td>
                                //        <td>${item.lowCount}</td>                                        
                                //        <td style='border-right:1px solid #dee2e6;'>${item.totalCount}</td>
                                //
                                //        <td>${item.ingStatus}</td>
                                //        <td>${item.endStatus}</td>
                                //        <td>${item.endPercent}%</td>
                                //        <td>${item.scheduledCount}</td>
                                //        <td>${item.answeredCount}</td>
                                //        <td>${item.delayedCount}</td>
                                //    </tr>`            
                                //);

                                //totalVeryHightCount += item.veryHighCount;
                                //totalHightCount += item.highCount;
                                //totalMediumCount += item.mediumCount;
                                //totalLowCount += item.lowCount;
                                //totalCount += item.totalCount;
                                //totalScheduledCount += item.scheduledCount;
                                //totalAnsweredCount += item.answeredCount;
                                //totalIngStatus += item.ingStatus;
                                //totalEndStatus += item.endStatus;
                                //totalDelayedCount += item.delayedCount;
                                
                                // 차트 데이터 업데이트
                                //chartData.push({ state: item.divisionName, ing: item.ingStatus, end: item.endStatus, total: item.totalCount });
                                chartData.push({ state: item.divisionName, ing: item.ingStatus, end: item.endStatus, total: item.totalCount });

                            });

                            // 4. 합계 행 추가
                            tableBody.append(createRow('<strong>합계</strong>', totals, true));

                            //tableBody.append(
                            //        `<tr>
                            //            <th><strong>합계</strong></td>
                            //            <td><strong>${totalVeryHightCount}</strong></td>
                            //            <td><strong>${totalHightCount}</strong></td>
                            //            <td><strong>${totalMediumCount}</strong></td>
                            //            <td><strong>${totalLowCount}</strong></td>                                        
                            //            <td style='border-right:1px solid #dee2e6;'><strong>${totalCount}</strong></td>
                            //
                            //            <td><strong>${totalIngStatus}</strong></td>
                            //            <td><strong>${totalEndStatus}</strong></td>
                            //            <td><strong>-</strong></td>
                            //            <td><strong>${totalScheduledCount}</strong></td>
                            //            <td><strong>${totalAnsweredCount}</strong></td>
                            //            <td><strong>${totalDelayedCount}</strong></td>
                            //        </tr>`
                            //    );
                            //
                            
                            // 
                            //var totalpercent = Math.round( (totalEndStatus / ( totalIngStatus + totalEndStatus ) * 1000) ) / 10;
                            var totalpercent = Math.round( (totals.end / ( totals.ing + totals.end ) * 1000) ) / 10;
                            $('#requestsTotalPercent').text(totalpercent + "%");
                            
                            var chartInstance = $('#deptChart').dxChart('instance');
                            if (chartInstance) {
                                chartInstance.option('dataSource', chartData);
                            }

                        }
                    } else {
                        console.error("사업부서별 요청사항 수 조회 실패:", response.message);
                        $('#divisionStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("사업부서별 요청사항 수 조회 실패:", status, error);
                    $('#divisionStatsTableBody').empty().append('<tr><td colspan="4">데이터 로드 오류</td></tr>');
                }
            });

            // 사무실별 긴급도별 요청사항 수 조회 및 테이블 채우기
            $.ajax({
                url: '/api/StatisticsApi/by-office',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.stats) {
                        let tableBody = $('#officeStatsTableBody');
                        tableBody.empty(); // 기존 플레이스홀더 데이터 제거

                        if (response.stats.length === 0) {
                            tableBody.append('<tr><td colspan="4">데이터가 없습니다.</td></tr>');
                        } else {
                            response.stats.forEach(function(item) {
                                tableBody.append(
                                    `<tr>
                                        <th>${item.divisionName}</td>
                                        <td>${item.veryHighCount}</td>
                                        <td>${item.highCount}</td>
