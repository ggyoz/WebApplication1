@using System.Security.Claims
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer

@{
    ViewData["Title"] = "Dashboard";
    var currentUserRole = User.FindFirst(ClaimTypes.Role)?.Value;
}

<div class="container mt-4">
    <h3 class="display-6 mb-4">Dashboard</h3>

    <div class="row">
        <!-- KPI Cards Section -->
        @if (User.IsInRole("R4")) // Admin
        {
            <div class="col-md-3 mb-4">
                <div class="card blueCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">총 요청 수</h5>
                                <p class="card-text mb-0">전체 시스템의 요청 현황</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r4TotalRequestsCount">0</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card yellowCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">내 접수요청</h5>
                                <p class="card-text mb-0">내가 처리해야 할 접수된 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r4PendingRequestsCount">0</p>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card greenCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">진행중인 요청</h5>
                                <p class="card-text mb-0">내가 처리중인 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r4InProgressRequestsCount">0</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card redCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <h5 class="card-title mb-0">기한 초과</h5>
                                <p class="card-text mb-0">기한을 넘긴 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r4OverdueRequestsCount">0</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (User.IsInRole("R3")) // Manager
        {
            <div class="col-md-3 mb-4">
                <div class="card blueCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <h5 class="card-title mb-0">총 요청 수</h5>
                                <p class="card-text mb-0">전체 시스템의 요청 현황</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r3TotalRequestsCount">0</p>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card yellowCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <h5 class="card-title mb-0">내 접수요청</h5>
                                <p class="card-text mb-0">내가 처리해야 할 접수된 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r3PendingRequestsCount">0</p>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card greenCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <h5 class="card-title mb-0">진행중인 요청</h5>
                                <p class="card-text mb-0">내가 처리중인 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r3InProgressRequestsCount">0</p>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card redCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <h5 class="card-title mb-0">기한 초과</h5>
                                <p class="card-text mb-0">기한을 넘긴 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r3OverdueRequestsCount">0</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (User.IsInRole("R2")) // Team Leader
        {
            <div class="col-md-3 mb-4">
                <div class="card greenCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <h5 class="card-title mb-0">법인 총 요청</h5>
                                <p class="card-text mb-0">우리 법인의 전체 요청 건수</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r2CorpTotalRequestsCount">0</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card bg-info text-white shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">부서 총 요청</h5>
                                <p class="card-text mb-0">우리 부서의 전체 요청 건수</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r2DeptTotalRequestsCount">0</p>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card blueCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">팀 총 요청</h5>
                                <p class="card-text mb-0">우리 팀의 전체 요청 건수</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r2TeamTotalRequestsCount">0</p>
                        </div>
                        
                    </div>
                </div>
            </div>            
            <div class="col-md-3 mb-4">
                <div class="card redCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">기한 초과</h5>
                                <p class="card-text mb-0">기한을 넘긴 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r2OverdueRequestsCount"><small>%</small></p>
                        </div>
                        
                    </div>
                </div>
            </div>
        }
        else if (User.IsInRole("R1")) // Team Member
        {
            <div class="col-md-4 mb-4">
                <div class="card blueCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">내 요청</h5>
                                <p class="card-text mb-0">내가 등록한 총 요청 건수</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r1TotalRequestsCount"></p>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card yellowCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">진행 중</h5>
                                <p class="card-text mb-0">현재 진행 중인 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r1InProgressRequestsCount"></p>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card greenCard shadow-sm h-100">
                    <div class="card-body m-3">
                        <div class="d-flex justify-content-between align-items-center"> 
                            <div class="d-flex flex-column"> 
                                <h5 class="card-title mb-0">답변 완료</h5>
                                <p class="card-text mb-0">답변 완료된 나의 요청</p>
                            </div>
                            <p class="card-text display-5 mb-0" id="r1CompletedRequestsCount"></p>
                        </div>
                        
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Main Content Widgets Section -->
    <div class="row">
        @if (User.IsInRole("R4") || User.IsInRole("R3")) // Admin or Manager
        {
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body m-3">
                        <h5 class="card-title">전체 요청 현황 분석</h5>
                        <div id="chart" style="height: 250px; background-color: #f8f9fa; border: 1px dashed #ced4da; display: flex; align-items: center; justify-content: center;"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body m-3">
                        <h5 class="card-title">전체 진척율 및 지연율</h5>
                        <div id="chart_2" style="height: 250px; background-color: #f8f9fa; border: 1px dashed #ced4da; display: flex; align-items: center; justify-content: center;"></div>
                    </div>
                </div>
            </div>
        }
        else if (User.IsInRole("R2")) // Team Leader
        {
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body m-3">
                        <h5 class="card-title mb-3">법인별 요청 현황</h5>
                         <div id="chartR2" style="height: 250px; background-color: #f8f9fa; border: 1px dashed #ced4da; display: flex; align-items: center; justify-content: center;">
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body m-3">
                        <h5 class="card-title mb-3">법인별 진척율 및 지연율</h5>
                        <div id="chartR2_2" style="height: 250px; background-color: #f8f9fa; border: 1px dashed #ced4da; display: flex; align-items: center; justify-content: center;">
                            
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (User.IsInRole("R1")) // Team Member
        {
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body m-3">
                        <h5 class="card-title mb-3">나의 요청 현황</h5>
                        <div id="chartR1" style="height: 250px; background-color: #f8f9fa; border: 1px dashed #ced4da; display: flex; align-items: center; justify-content: center;"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body m-3">
                        <h5 class="card-title mb-3">진척율 및 지연율</h5>
                        <div id="chartR1_2" style="height: 250px; background-color: #f8f9fa; border: 1px dashed #ced4da; display: flex; align-items: center; justify-content: center;"></div>
                        <ul class="list-group list-group-flush">
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body m-3">                    
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="card-title">내 요청 최근 활동</h6>
                        </div>
                        <div class="col-md-6">
                            <h6 class="card-title">공지사항</h6>
                        </div>
                        <div class="col-md-6">
                            @if (User.IsInRole("R4") || User.IsInRole("R3"))
                            {
                                <ul class="list-group list-group-flush" id="r3r4RecentActivitiesList">
                                    <li class="list-group-item">표시할 활동이 없습니다.</li>
                                </ul>
                            }else if (User.IsInRole("R2"))
                            {
                                <ul class="list-group list-group-flush" id="">
                                    <li class="list-group-item">표시할 활동이 없습니다.</li>
                                </ul>
                            }else if (User.IsInRole("R1")){
                                <ul class="list-group list-group-flush" id="myRecentActivitiesList">
                                    <li class="list-group-item">표시할 활동이 없습니다.</li>
                                </ul>
                            }                            
                        </div>
                        <div class="col-md-6">                            
                            <ul class="list-group list-group-flush" id="recentNoticesList">
                                <li class="list-group-item">표시할 공지사항이 없습니다.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>

    /* 차트 placeholder 스타일 */
    .chart-placeholder {
        height: 250px;
        background-color: #f8f9fa;
        border: 1px dashed #ced4da;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #6c757d;
    }
</style>

@section Scripts {
    <script>

        $(document).ready(function() {                    

            // R3, 4
            let dataSource = [
                { status: '대기', data: 3, }, 
                { status: '접수', data: 2, },
                { status: '진행중', data: 3, },                  
                { status: '종결', data: 6, }];

            const currentUserRole = '@currentUserRole';
            
            if (currentUserRole === 'R4' || currentUserRole === 'R3') {
            
                $('#chart').dxChart({
                    dataSource,
                    series: {
                        argumentField: 'status',
                        valueField: 'data',
                        type: 'bar',
                        color: '#ffaa66',
                    },
                    commonSeriesSettings: {
                        label: {
                        visible : true,                        
                            connector: {
                                visible: true,

                            },
                        },
                    },
                    legend: {
                        visible: false,
                    },
                });

                $('#chart_2').dxChart({
                    dataSource: [],
                    series: {
                        argumentField: 'status',
                        valueField: 'data',
                        type: 'bar',
                        color: '#5bc0de',
                    },
                    commonSeriesSettings: {
                        label: {
                        visible : true,                        
                            connector: {
                                visible: true,

                            },
                        },
                    },
                    legend: {
                        visible: false,
                    },
                });

            }else if (currentUserRole === 'R2') {

                $('#chartR2').dxChart({
                    dataSource,
                    series: {
                    argumentField: 'status',
                    valueField: 'data',
                    type: 'bar', 
                    color: '#0068ff',
                    },                    
                    commonSeriesSettings: {
                        label: {
                        visible : true,                        
                            connector: {
                                visible: true,

                            },
                        },
                    },
                    legend: {
                        visible: false,
                    },
                });

                $('#chartR2_2').dxChart({
                    dataSource,
                    series: {
                    argumentField: 'status',
                    valueField: 'data',
                    type: 'bar', 
                    color: '#5bc0de',
                    },
                    commonSeriesSettings: {
                        label: {
                        visible : true,
                            connector: {
                                visible: true
                            }
                        }
                    },
                    legend: {
                        visible: false,
                    },
                });

            }else if (currentUserRole === 'R1') {

                $('#chartR1').dxChart({
                    dataSource,
                    series: {
                    argumentField: 'status',
                    valueField: 'data',
                    type: 'bar', 
                    color: '#0068ff',
                    },
                    legend: {
                        visible: false,
                    },
                });

                $('#chartR1_2').dxChart({
                    dataSource,
                    series: {
                    argumentField: 'status',
                    valueField: 'data',
                    type: 'bar', 
                    color: '#5bc0de',
                    },
                    legend: {
                        visible: false,
                    },
                });

            }            
            
            // JavaScript에서 사용하기 위한 지역화된 히스토리 사유 맵
            var localizedHistoryReasons = {
                "71": '@SharedLocalizer["CC71"]', // 최초등록
                "72": '@SharedLocalizer["CC72"]', // 접수 완료
                "73": '@SharedLocalizer["CC73"]', // 답변 등록
                "74": '@SharedLocalizer["CC74"]', // 일정 변경
                "75": '@SharedLocalizer["CC75"]', // 담당자 변경
                "76": '@SharedLocalizer["CC76"]', // 종결
                "77": '@SharedLocalizer["CC77"]'  // 재문의
            };
            
            if (currentUserRole === 'R1') {
                // 신규 통합 API 호출: 내 요청 상태별 카운트 및 차트 업데이트
                $.ajax({
                    url: '/api/ReqApi/my-counts',
                    type: 'GET',
                    success: function(data) {
                        // 카드 정보 업데이트 (대기+접수+진행+종결 = 전체)
                        var totalCount = data.WAITCOUNT + data.RECEIVEDCOUNT + data.INPROGRESSCOUNT + data.CLOSEDCOUNT;
                        
                        $('#r1TotalRequestsCount').text(totalCount);
                        $('#r1InProgressRequestsCount').text(data.INPROGRESSCOUNT);
                        $('#r1CompletedRequestsCount').text(data.CLOSEDCOUNT);

                        // 차트 데이터 업데이트
                        var r1ChartData = [
                            { status: '대기', data: data.WAITCOUNT },
                            { status: '접수', data: data.RECEIVEDCOUNT },
                            { status: '진행중', data: data.INPROGRESSCOUNT },
                            { status: '종결', data: data.CLOSEDCOUNT }
                        ];
                        
                        var chartInstance = $('#chartR1').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', r1ChartData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 요청 통계 API 오류:', error);
                    }
                });

                $.ajax({
                    url: '/api/ReqApi/my-performance',
                    type: 'GET',
                    success: function(data) {                                        
                        var r1ChartData = [
                            { status: '처리', data: data.completedCount },
                            { status: '지연', data: data.delayedCount }                            
                        ];
                        
                        var chartInstance = $('#chartR1_2').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', r1ChartData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 요청 통계 API 오류:', error);
                    }
                });

                // 내 요청 최근 활동 조회 (기존 유지)
                $.ajax({
                    url: '/Req/GetMyRecentReqActivities', 
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.activities && response.activities.length > 0) {
                            var activitiesList = $('#myRecentActivitiesList');
                            activitiesList.empty(); 
                            $.each(response.activities, function(index, activity) {
                                console.log(activity);
                                var date = new Date(activity.reG_DATE);
                                var formattedDate = date.getFullYear() + '-' + ('0' + (date.getMonth() + 1)).slice(-2) + '-' + ('0' + date.getDate()).slice(-2);
                                activitiesList.append('<li class="list-group-item"><a href="/Req/Details/' + activity.reqid + '">' + '[요청 #' + activity.reqid + '] ' + activity.title + ' (' + localizedHistoryReasons[activity.historY_REASON] + ')</a><span class="text-end">'+ formattedDate +'</span></li>');
                            });
                        } else {
                            var activitiesList = $('#myRecentActivitiesList');
                            activitiesList.empty();
                            activitiesList.append('<li class="list-group-item">표시할 요청 활동이 없습니다.</li>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 요청 최근 활동 AJAX 오류:', error);
                        var activitiesList = $('#myRecentActivitiesList');
                        activitiesList.empty();
                        activitiesList.append('<li class="list-group-item">요청 활동을 불러오는 중 오류가 발생했습니다.</li>');
                    }
                });

            } else if (currentUserRole === 'R2') {
                // 법인 통합 통계 API 호출
                $.ajax({
                    url: '/api/ReqApi/corp-counts',
                    type: 'GET',
                    success: function(data) {
                        // 법인 총 요청 카드 업데이트
                        var totalCount = data.WAITCOUNT + data.RECEIVEDCOUNT + data.INPROGRESSCOUNT + data.CLOSEDCOUNT;
                        $('#r2CorpTotalRequestsCount').text(totalCount);                        

                        // 법인별 요청 현황 차트 업데이트
                        var corpChartData = [
                            { status: '대기', data: data.WAITCOUNT },
                            { status: '접수', data: data.RECEIVEDCOUNT },
                            { status: '진행중', data: data.INPROGRESSCOUNT },
                            { status: '종결', data: data.CLOSEDCOUNT }
                        ];
                        
                        var chartInstance = $('#chartR2').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', corpChartData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('법인 통계 API 오류:', error);
                    }
                });

                // 법인 퍼포먼스(진척율, 지연율) API 호출
                $.ajax({
                    url: '/api/ReqApi/corp-performance',
                    type: 'GET',
                    success: function(data) {

                        $("#r2OverdueRequestsCount").text(data.delayedCount);

                        var corpPerfData = [
                            { status: '처리', data: data.completedCount },
                            { status: '지연', data: data.delayedCount }
                        ];

                        
                        var chartInstance = $('#chartR2_2').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', corpPerfData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('법인 퍼포먼스 API 오류:', error);
                    }
                });

                $.ajax({
                    url: '/Req/GetDeptTotalRequestsCount',
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            $('#r2DeptTotalRequestsCount').text(response.count);
                        } else {
                            console.error('부서 총 요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('부서 총 요청 건수 AJAX 오류:', error);
                    }
                });

                $.ajax({
                    url: '/Req/GetTeamRequestCount', 
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            $('#r2TeamTotalRequestsCount').text(response.count);
                        } else {
                            console.error('팀 요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('팀 요청 건수 AJAX 오류:', error);
                    }
                });
            
            } else if (currentUserRole === 'R3' || currentUserRole === 'R4') {
                // 전체 시스템 통계 API 호출
                $.ajax({
                    url: '/api/ReqApi/all-counts',
                    type: 'GET',
                    success: function(data) {
                        // 총 요청 수 카드 업데이트
                        var totalCount = data.WAITCOUNT + data.RECEIVEDCOUNT + data.INPROGRESSCOUNT + data.CLOSEDCOUNT;
                        if (currentUserRole === 'R4') {
                            $('#r4TotalRequestsCount').text(totalCount);
                        } else {
                            $('#r3TotalRequestsCount').text(totalCount);
                        }

                        // 전체 현황 차트 업데이트
                        var allChartData = [
                            { status: '대기', data: data.WAITCOUNT },
                            { status: '접수', data: data.RECEIVEDCOUNT },
                            { status: '진행중', data: data.INPROGRESSCOUNT },
                            { status: '종결', data: data.CLOSEDCOUNT }
                        ];
                        
                        var chartInstance = $('#chart').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', allChartData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('전체 통계 API 오류:', error);
                    }
                });

                // 전체 시스템 퍼포먼스 API 호출
                $.ajax({
                    url: '/api/ReqApi/all-performance',
                    type: 'GET',
                    success: function(data) {
                        var allPerfData = [
                            { status: '처리율', data: data.completedCount },
                            { status: '지연율', data: data.delayedCount }
                        ];
                        
                        var chartInstance = $('#chart_2').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', allPerfData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('전체 퍼포먼스 API 오류:', error);
                    }
                });

                $.ajax({
                    url: '/Req/GetMyPendingRequestsCount',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            if(currentUserRole === 'R3') {
                                $('#r3PendingRequestsCount').text(response.count);
                            } else {
                                $('#r4PendingRequestsCount').text(response.count);
                            }
                        } else {
                            console.error('내 접수요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 접수요청 건수 AJAX 오류:', error);
                    }
                });                

                $.ajax({
                    url: '/Req/GetMyInProgressCount',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            if(currentUserRole === 'R3') {
                                $('#r3InProgressRequestsCount').text(response.count);
                            } else {
                                $('#r4InProgressRequestsCount').text(response.count);
                            }
                        } else {
                            console.error('내 진행중 요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 진행중 요청 건수 AJAX 오류:', error);
                    }
                });

                $.ajax({
                    url: '/Req/GetMyOverdueRequestsCount',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            if(currentUserRole === 'R3') {
                                $('#r3OverdueRequestsCount').text(response.count);
                            } else {
                                $('#r4OverdueRequestsCount').text(response.count);
                            }
                        } else {
                            console.error('내 기한초과 요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 기한초과 요청 건수 AJAX 오류:', error);
                    }
                });

                // R3/R4 최근 활동 조회 (RESUSERID 기준)
                $.ajax({
                    url: '/Req/GetMyAssignedRecentReqActivities', // New API endpoint
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.activities && response.activities.length > 0) {
                            var activitiesList = $('#r3r4RecentActivitiesList');
                            activitiesList.empty(); // Clear existing placeholders
                            $.each(response.activities, function(index, activity) {
                                console.log(activity);
                                var date = new Date(activity.reG_DATE);
                                var formattedDate = date.getFullYear() + '-' + ('0' + (date.getMonth() + 1)).slice(-2) + '-' + ('0' + date.getDate()).slice(-2);
                                activitiesList.append('<li class="list-group-item d-flex justify-content-between align-items-center"><a href="/Req/Details/' + activity.reqid + '">' + '[요청 #' + activity.reqid + '] ' + activity.title + ' (' + localizedHistoryReasons[activity.historY_REASON] + ')</a><span class="text-end">'+ formattedDate +'</span></li>');
                            });
                        } else {
                            var activitiesList = $('#r3r4RecentActivitiesList');
                            activitiesList.empty();
                            activitiesList.append('<li class="list-group-item">표시할 활동이 없습니다.</li>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('R3/R4 최근 활동 AJAX 오류:', error);
                        var activitiesList = $('#r3r4RecentActivitiesList');
                        activitiesList.empty();
                        activitiesList.append('<li class="list-group-item">활동을 불러오는 중 오류가 발생했습니다.</li>');
                    }
                });

            }

            // 공지사항 조회 (최근 5개)
            $.ajax({
                url: '/Notice/GetRecentNotices', // API endpoint
                type: 'GET',
                success: function(response) {
                    if (response.success && response.notices && response.notices.length > 0) {
                        var noticesList = $('#recentNoticesList');
                        noticesList.empty(); // Clear existing placeholders
                        $.each(response.notices, function(index, notice) {
                            var date = new Date(notice.reG_DATE);
                            var formattedDate = date.getFullYear() + '-' + ('0' + (date.getMonth() + 1)).slice(-2) + '-' + ('0' + date.getDate()).slice(-2);
                            noticesList.append('<li class="list-group-item d-flex justify-content-between align-items-center"><a href="/Notice/Details/' + notice.id + '">' + '[' + notice.codeName + '] ' + notice.title + '</a><span class="text-end">'+ formattedDate +'</span></li>');
                        });
                    } else {
                        var noticesList = $('#recentNoticesList');
                        noticesList.empty();
                        noticesList.append('<li class="list-group-item">표시할 공지사항이 없습니다.</li>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('최신 공지사항 AJAX 오류:', error);
                    var noticesList = $('#recentNoticesList');
                    noticesList.empty();
                    noticesList.append('<li class="list-group-item">공지사항을 불러오는 중 오류가 발생했습니다.</li>');
                }
            });
        });
    </script>
}

