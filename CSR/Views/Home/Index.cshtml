            };
            
            if (currentUserRole === 'R1') {
                // 신규 통합 API 호출: 내 요청 상태별 카운트 및 차트 업데이트
                $.ajax({
                    url: '/api/ReqApi/my-counts',
                    type: 'GET',
                    success: function(data) {
                        // 카드 정보 업데이트 (대기+접수+진행+종결 = 전체)
                        var totalCount = data.WAITCOUNT + data.RECEIVEDCOUNT + data.INPROGRESSCOUNT + data.CLOSEDCOUNT + data.ANSWEREDCOUNT;
                        
                        $('#r1TotalRequestsCount').text(totalCount);
                        $('#r1InProgressRequestsCount').text(data.INPROGRESSCOUNT + data.RECEIVEDCOUNT + data.ANSWEREDCOUNT);
                        $('#r1CompletedRequestsCount').text(data.CLOSEDCOUNT);
                        $('#r1AnsweredRequestsCount').text(data.ANSWEREDCOUNT);

                        // 차트 데이터 업데이트
                        var r1ChartData = [
                            { status: localizedStatuses.waiting, data: data.WAITCOUNT },
                            { status: localizedStatuses.received, data: data.RECEIVEDCOUNT },
                            { status: localizedStatuses.inProgress, data: data.INPROGRESSCOUNT },
                            { status: localizedStatuses.answered, data: data.ANSWEREDCOUNT },
                            { status: localizedStatuses.closed, data: data.CLOSEDCOUNT }
                        ];
                        
                        var chartInstance = $('#chartR1').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', r1ChartData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 요청 통계 API 오류:', error);
                    }
                });

                $.ajax({
                    url: '/api/ReqApi/my-performance',
                    type: 'GET',
                    success: function(data) {                                        
                        var r1ChartData = [
                            { status: localizedStatuses.closed, data: data.completedCount }, // 종결
                            { status: localizedStatuses.delayed, data: data.delayedCount }  // 지연                        
                        ];
                        
                        var chartInstance = $('#chartR1_2').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', r1ChartData);
                        }

                        $("#r1OverdueRequestsCount").text(data.delayedCount);
                    },
                    error: function(xhr, status, error) {
                        console.error('내 요청 통계 API 오류:', error);
                    }
                });

                // 내 요청 최근 활동 조회 (기존 유지)
                $.ajax({
                    url: '/Req/GetMyRecentReqActivities', 
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.activities && response.activities.length > 0) {
                            var activitiesList = $('#myRecentActivitiesList');
                            activitiesList.empty(); 
                            $.each(response.activities, function(index, activity) {
                                var date = new Date(activity.reG_DATE);
                                var formattedDate = date.getFullYear() + '-' + ('0' + (date.getMonth() + 1)).slice(-2) + '-' + ('0' + date.getDate()).slice(-2);
                                activitiesList.append('<li class="list-group-item d-flex justify-content-between align-items-center"><a href="/Req/Details/' + activity.reqid + '">' + '[요청 #' + activity.reqid + '] ' + activity.title + ' (' + localizedHistoryReasons[activity.historY_REASON] + ')</a><span class="text-end">'+ formattedDate +'</span></li>');
                            });
                        } else {
                            var activitiesList = $('#myRecentActivitiesList');
                            activitiesList.empty();
                            activitiesList.append('<li class="list-group-item">@SharedLocalizer["Dashboard_NoActivities"]</li>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 요청 최근 활동 AJAX 오류:', error);
                        var activitiesList = $('#myRecentActivitiesList');
                        activitiesList.empty();
                        activitiesList.append('<li class="list-group-item">@SharedLocalizer["Dashboard_Error_LoadingActivities"]</li>');
                    }
                });

            } else if (currentUserRole === 'R2') {
                // R2 권한: 스코프에 따른 API 호출
                const userTeamCd = '@Context.Session.GetString("TeamCd")';
                const userOfficeCd = '@Context.Session.GetString("OfficeCd")';
                const userDeptCd = '@Context.Session.GetString("DeptCd")';
                const userCorCd = '@Context.Session.GetString("CorCd")';

                let apiScope = 'corp';
                let elementPrefix = 'r2Corp';

                if (userTeamCd) { apiScope = 'team'; elementPrefix = 'r2Team'; }
                else if (userOfficeCd) { apiScope = 'office'; elementPrefix = 'r2Office'; }
                else if (userDeptCd) { apiScope = 'dept'; elementPrefix = 'r2Dept'; }

                // 1. 상태별 카운트 조회
                $.ajax({
                    url: `/api/ReqApi/${apiScope}-counts`,
                    type: 'GET',
                    success: function(data) {
                        var totalCount = data.WAITCOUNT + data.RECEIVEDCOUNT + data.INPROGRESSCOUNT + data.CLOSEDCOUNT + data.ANSWEREDCOUNT;
                        $(`#${elementPrefix}TotalCount`).text(totalCount);
                        $(`#${elementPrefix}InProgressCount`).text(data.INPROGRESSCOUNT + data.RECEIVEDCOUNT + data.ANSWEREDCOUNT);
                        $(`#${elementPrefix}AnsweredCount`).text(data.ANSWEREDCOUNT);

                        var chartData = [
                            { status: localizedStatuses.waiting, data: data.WAITCOUNT },
                            { status: localizedStatuses.received, data: data.RECEIVEDCOUNT },
                            { status: localizedStatuses.inProgress, data: data.INPROGRESSCOUNT },
                            { status: localizedStatuses.answered, data: data.ANSWEREDCOUNT },
                            { status: localizedStatuses.closed, data: data.CLOSEDCOUNT }
                        ];
                        
                        var chartInstance = $('#chartR2').dxChart('instance');
                        if (chartInstance) chartInstance.option('dataSource', chartData);
                    }
                });

                // 2. 퍼포먼스(지연건수 등) 조회
                $.ajax({
                    url: `/api/ReqApi/${apiScope}-performance`,
                    type: 'GET',
                    success: function(data) {
                        $(`#${elementPrefix}OverdueCount`).text(data.delayedCount);

                        var perfData = [
                            { status: localizedStatuses.closed, data: data.completedCount },
                            { status: localizedStatuses.delayed, data: data.delayedCount }
                        ];

                        var chartInstance = $('#chartR2_2').dxChart('instance');
                        if (chartInstance) chartInstance.option('dataSource', perfData);
                    }
                });
            
            } else if (currentUserRole === 'R3' || currentUserRole === 'R4') {
                // 전체 시스템 통계 API 호출
                $.ajax({
                    url: '/api/ReqApi/all-counts',
                    type: 'GET',
                    success: function(data) {
                        // 총 요청 수 카드 업데이트
                        var totalCount = data.WAITCOUNT + data.RECEIVEDCOUNT + data.INPROGRESSCOUNT + data.CLOSEDCOUNT + data.ANSWEREDCOUNT;
                        if (currentUserRole === 'R4') {
                            $('#r4TotalRequestsCount').text(totalCount);
                            $('#r4OverAnsweredRequestsCount').text(data.ANSWEREDCOUNT);                            
                        } else {
                            $('#r3TotalRequestsCount').text(totalCount);
                        }

                        // 전체 현황 차트 업데이트
                        var allChartData = [
                            { status: localizedStatuses.waiting, data: data.WAITCOUNT },
                            { status: localizedStatuses.received, data: data.RECEIVEDCOUNT },
                            { status: localizedStatuses.inProgress, data: data.INPROGRESSCOUNT },
                            { status: localizedStatuses.answered, data: data.ANSWEREDCOUNT },
                            { status: localizedStatuses.closed, data: data.CLOSEDCOUNT }
                        ];
                        
                        var chartInstance = $('#chart').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', allChartData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('전체 통계 API 오류:', error);
                    }
                });

                // 전체 시스템 퍼포먼스 API 호출
                $.ajax({
                    url: '/api/ReqApi/all-performance',
                    type: 'GET',
                    success: function(data) {
                        var allPerfData = [
                            { status: localizedStatuses.closed, data: data.completedCount },
                            { status: localizedStatuses.delayed, data: data.delayedCount }
                        ];
                        
                        var chartInstance = $('#chart_2').dxChart('instance');
                        if (chartInstance) {
                            chartInstance.option('dataSource', allPerfData);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('전체 퍼포먼스 API 오류:', error);
                    }
                });

                $.ajax({
                    url: '/Req/GetMyPendingRequestsCount',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            if(currentUserRole === 'R3') {
                                $('#r3PendingRequestsCount').text(response.count);
                            } else {
                                $('#r4PendingRequestsCount').text(response.count);
                            }
                        } else {
                            console.error('내 접수요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 접수요청 건수 AJAX 오류:', error);
                    }
                });                

                $.ajax({
                    url: '/Req/GetMyInProgressCount',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            if(currentUserRole === 'R3') {
                                $('#r3InProgressRequestsCount').text(response.count);
                            } else {
                                $('#r4InProgressRequestsCount').text(response.count);
                            }
                        } else {
                            console.error('내 진행중 요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 진행중 요청 건수 AJAX 오류:', error);
                    }
                });

                $.ajax({
                    url: '/Req/GetMyOverdueRequestsCount',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            if(currentUserRole === 'R3') {
                                $('#r3OverdueRequestsCount').text(response.count);
                            } else {
                                $('#r4OverdueRequestsCount').text(response.count);
                            }
                        } else {
                            console.error('내 기한초과 요청 건수 가져오기 실패:', response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('내 기한초과 요청 건수 AJAX 오류:', error);
                    }
                });

                // R3/R4 최근 활동 조회 (RESUSERID 기준)
                $.ajax({
                    url: '/Req/GetMyAssignedRecentReqActivities', // New API endpoint
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.activities && response.activities.length > 0) {
                            var activitiesList = $('#r3r4RecentActivitiesList');
                            activitiesList.empty(); // Clear existing placeholders
                            $.each(response.activities, function(index, activity) {                                
                                var date = new Date(activity.reG_DATE);
                                var formattedDate = date.getFullYear() + '-' + ('0' + (date.getMonth() + 1)).slice(-2) + '-' + ('0' + date.getDate()).slice(-2);
                                activitiesList.append('<li class="list-group-item d-flex justify-content-between align-items-center"><a href="/Req/Details/' + activity.reqid + '">' + '[요청 #' + activity.reqid + '] ' + activity.title + ' (' + localizedHistoryReasons[activity.historY_REASON] + ')</a><span class="text-end">'+ formattedDate +'</span></li>');
                            });
                        } else {
                            var activitiesList = $('#r3r4RecentActivitiesList');
                            activitiesList.empty();
                            activitiesList.append('<li class="list-group-item">@SharedLocalizer["Dashboard_NoActivities"]</li>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('R3/R4 최근 활동 AJAX 오류:', error);
                        var activitiesList = $('#r3r4RecentActivitiesList');
                        activitiesList.empty();
                        activitiesList.append('<li class="list-group-item">@SharedLocalizer["Dashboard_Error_LoadingActivities"]</li>');
                    }
                });

            }

            // 공지사항 조회 (최근 5개)
            $.ajax({
                url: '/Notice/GetRecentNotices', // API endpoint
                type: 'GET',
                success: function(response) {
                    if (response.success && response.notices && response.notices.length > 0) {
                        var noticesList = $('#recentNoticesList');
                        noticesList.empty(); // Clear existing placeholders
                        $.each(response.notices, function(index, notice) {
                            var date = new Date(notice.reG_DATE);
                            var formattedDate = date.getFullYear() + '-' + ('0' + (date.getMonth() + 1)).slice(-2) + '-' + ('0' + date.getDate()).slice(-2);
                            noticesList.append('<li class="list-group-item d-flex justify-content-between align-items-center"><a href="/Notice/Details/' + notice.id + '">' + '[' + notice.codeName + '] ' + notice.title + '</a><span class="text-end">'+ formattedDate +'</span></li>');
                        });
                    } else {
                        var noticesList = $('#recentNoticesList');
                        noticesList.empty();
                        noticesList.append('<li class="list-group-item">@SharedLocalizer["Dashboard_NoNotices"]</li>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('최신 공지사항 AJAX 오류:', error);
                    var noticesList = $('#recentNoticesList');
                    noticesList.empty();
                    noticesList.append('<li class="list-group-item">@SharedLocalizer["Dashboard_Error_LoadingNotices"]</li>');
                }
            });
        });
    </script>
}

