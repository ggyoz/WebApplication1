<div style="margin-top: 20px; padding: 15px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-left: 4px solid #198754; border-radius: 4px;">
    <strong>조치 내용(답변):</strong><br />
    <div style="margin-top: 10px; max-height: 300px; overflow-y: auto; background-color: #ffffff; padding: 10px; border: 1px solid #eee;">
        @Html.Raw(Model.ANSWER_HTML)
    </div>
</div> *@
