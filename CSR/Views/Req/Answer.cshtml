@model ReqInfo
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Authorization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer
@inject IAuthorizationService AuthorizationService
@inject IHttpContextAccessor HttpContextAccessor
@using System.Security.Claims

@{
    ViewData["Title"] = "요구사항 수정";
}

<div class="d-flex justify-content-between"> 
    <div class="text-start">
        <partial name="_PageTitlePartial" />
    </div>

    <div class="text-end">
        <a id="btnSaveTop" class="btn btn-primary" style="cursor:pointer;">@SharedLocalizer["Button_Save"]</a>
        <a asp-action="Index" class="btn btn-list">@SharedLocalizer["Button_List"]</a>
    </div>
</div>

<hr />
<div class="row">
    <div class="col-md-12">
        <form id="answerForm" asp-action="Answer" onsubmit="return validateForm();" asp-route-id="@Model.REQID" enctype="multipart/form-data">
            <input type="hidden" asp-for="REQID" />
            <input type="hidden" asp-for="REG_USERID" />
            <div asp-validation-summary="All" class="text-danger"></div>


            <table class="table-create" width="100%; min-width:600px;">
                <colgroup>
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                </colgroup>
                <tbody>
                    <tr>    
                        <td><label asp-for="ReqUserName" class="control-label" >요청자 이름</label><div id="btnSearchUser" class="ms-2"></div></td>
                        <td><input asp-for="ReqUserName" class="form-control" readonly /></td>
                        <td><label asp-for="REQUSERID" class="control-label" >사번</label></td>
                        <td><input asp-for="REQUSERID" class="form-control" readonly /></td>
                        <td><label asp-for="REQDATE" class="control-label"></label></td>
                        <td><input asp-for="REQDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="DUEDATE" class="control-label"></label></td>
                        <td><input asp-for="DUEDATE" type="date" class="form-control" /></td>
                        
                    </tr>
                    <tr>
                        <td><label asp-for="CORCD" class="control-label"></label></td>
                        <td><input asp-for="CORCD" class="form-control" readonly /></td>
                        <td><label asp-for="DEPTCD" class="control-label"></label></td>
                        <td><input asp-for="DEPTCD" class="form-control" readonly /></td>
                        <td><label asp-for="OFFICECD" class="control-label"></label></td>
                        <td><input asp-for="OFFICECD" class="form-control" readonly /></td>
                        <td><label asp-for="TEAMCD" class="control-label"></label></td>
                        <td><input asp-for="TEAMCD" class="form-control" readonly /></td>
                    </tr>                    
                     <tr>
                        <td><label asp-for="EXPECTDATE" class="control-label"></label></td>
                        <td><input asp-for="EXPECTDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="STARTDATE" class="control-label"></label></td>
                        <td><input asp-for="STARTDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="ENDDATE" class="control-label"></label></td>
                        <td><input asp-for="ENDDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="MAN_DAY" class="control-label"></label></td>
                        <td><input asp-for="MAN_DAY" type="number" step="0.5" class="form-control" min="0" max="100" oninput="enforceMinMaxValue(this)" /></td>                        
                    </tr>
                    <tr>
                        <td><label asp-for="REQTYPE" class="control-label"></label></td>
                        <td><select asp-for="REQTYPE" asp-items="ViewBag.ReqTypes" class="form-select">
                                <option value="">@SharedLocalizer["Placeholder_SelectRequestType"]</option>
                            </select>
                        </td>
                        <td><label asp-for="SYSTEMCD" class="control-label"></label></td>
                        <td><select asp-for="SYSTEMCD" asp-items="ViewBag.SystemCodes" class="form-select">
                                <option value="">@SharedLocalizer["Placeholder_SelectSystem"]</option>
                            </select>
                        </td>
                        <td><label asp-for="REQMENU" class="control-label"></label></td>
                        <td><select asp-for="REQMENU" id="ReqMenu" asp-items="ViewBag.ReqMenu" class="form-select"></select></td>
                        <td><label asp-for="RESUSERID" class="control-label"></label></td>
                        <td><select asp-for="RESUSERID" class="form-select" asp-items="ViewBag.UserList">\
                                <option value="">@SharedLocalizer["조치자 선택"]</option>
                            </select></td>
                        
                        
                    </tr>
                    <tr>
                        <td><label asp-for="PRIORITYCD" class="control-label"></label></td>
                        <td><select asp-for="PRIORITYCD" asp-items="ViewBag.PriorityCodes" class="form-select">
                                <option value="">@SharedLocalizer["Placeholder_SelectUrgency"]</option>
                            </select>
                        </td>
                        <td><label asp-for="IMPTCD" class="control-label"></label></td>
                        <td><select asp-for="IMPTCD" asp-items="ViewBag.ImportantCodes" class="form-select">                                
                                <option value="">@SharedLocalizer["Placeholder_SelectImportance"]</option>
                            </select></td>   
                        <td><label asp-for="DFCLTCD" class="control-label"></label></td>
                        <td><select asp-for="DFCLTCD" asp-items="ViewBag.difficultCodes" class="form-select">
                                <option value="">@SharedLocalizer["Placeholder_SelectDifficulty"]</option>
                                
                            </select>
                        </td>
                        <td><label asp-for="PROC_STATUS" class="control-label"></label></td>
                        <td><select asp-for="PROC_STATUS" asp-items="ViewBag.ProcStatusCodes" class="form-select">
                                <option value="">@SharedLocalizer["진행상태 선택"]</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td><label asp-for="REQTCODE" class="control-label"></label></td>
                        <td><input asp-for="REQTCODE" class="form-control" /></td>
                        <td><label asp-for="RESTCODE" class="control-label"></label></td>
                        <td><input asp-for="RESTCODE" class="form-control" /></td>
                        <td><label asp-for="BXTID" class="control-label"></label></td>
                        <td><input asp-for="BXTID" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td><label asp-for="TITLE" class="control-label"></label></td>
                        <td colspan="7">
                            <input asp-for="TITLE" class="form-control" />
                            <span asp-validation-for="TITLE" class="text-danger"></span>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;"><label asp-for="CONTENTS_HTML" class="control-label"></label></td>
                        <td colspan="7">
                            <div id="content-editor"></div>
                            <input type="hidden" asp-for="CONTENTS_HTML" />
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;"><label asp-for="ANSWER_HTML" class="control-label"></label></td>
                        <td colspan="7">
                            <div id="answer-editor"></div>
                            <input type="hidden" asp-for="ANSWER_HTML" />
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;"><label asp-for="NOTE_HTML" class="control-label"></label></td>
                        <td colspan="7">
                            <div id="note-editor"></div>
                            <input type="hidden" asp-for="NOTE_HTML" />
                        </td>

                    </tr>
                    <tr>
                        <td>@SharedLocalizer["Label_Attachments"]</td>
                        <td colspan="7">
                            @if (Model.AttachFiles.Any())
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var file in Model.AttachFiles)
                                    {
                                        <li class="list-group-item">
                                            <input type="checkbox" name="deletedFiles" value="@file.FILEID" id="del-@file.FILEID" class="form-check-input" />
                                            <label for="del-@file.FILEID" class="form-check-label ms-2">@SharedLocalizer["Button_Delete"]</label>
                                            <a asp-action="DownloadFile" asp-route-id="@file.FILEID" class="ms-3">@file.REAL_FILENAME</a>
                                        </li>
                                    }
                                </ul>
                            }
                            <div>
                                <div id="file-uploader"></div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="button-area text-end mt-5 m-3">
                <input type="submit" value="@SharedLocalizer["Button_Save"]" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.REQID" class="btn btn-secondary">@SharedLocalizer["Button_Cancel"]</a>
                <a asp-action="Index" class="btn btn-list">@SharedLocalizer["Button_List"]</a>
            </div>
        </form>

        <div id="userSearchPopup">
            <div id="userSearchDataGrid"></div>
        </div>

    </div>
</div>


@section Scripts {
    <style>

        #file-uploader .dx-fileuploader-input-wrapper {
            min-height: 150px;
            border: 2px dashed #ccc;
            padding: 20px;
            background-color: #f8f9fa;
        }

        @* 이미지 넘침 방지 *@
        .dx-htmleditor-content img{
            max-width: 100%;
            height: auto;
            display: block;
            margin-bottom: 10px;
        }

        .table-create {            
            border-top:1px solid #ccc;
            border-bottom: 1px solid #ccc;
            margin-bottom: 20px;
            width: 100%;
        }
        .table-create th {
            background-color: #f8f9fa;
            color: #333;
            font-weight: bold;
            padding: 12px 10px;
            border-bottom: 1px solid #e2e8f0;
            text-align: right;
            vertical-align: middle;
        }
        .table-create td {
            padding: 8px 10px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }
        .table-create .form-control, .table-create .form-select {
            border-radius: 4px;
        }
        
        .html-editor .dx-htmleditor-content {
            white-space: normal; /* 텍스트가 자동으로 줄 바꿈되도록 설정 */
            word-break: break-word; /* 긴 단어도 줄 바꿈되도록 설정 */
            background-color:#ffffff;
        }
        
    </style>
    <script>

        const userDiv = '@HttpContextAccessor.HttpContext.User.FindFirst(ClaimTypes.Role)?.Value';



        $(function() {
            initializeHtmlEditor('#content-editor', 'input[name="@Html.NameFor(m => m.CONTENTS_HTML)"]');
            initializeHtmlEditor('#answer-editor', 'input[name="@Html.NameFor(m => m.ANSWER_HTML)"]');
            initializeHtmlEditor('#note-editor', 'input[name="@Html.NameFor(m => m.NOTE_HTML)"]');

            $("#file-uploader").dxFileUploader({
                name: 'newFiles',
                multiple: true,
                uploadMode: 'useForm'
            });          

            var systemcd = $('#SYSTEMCD').val();

            // 메뉴 
            if (systemcd) {
                var reqMenuValue = @Html.Raw(Json.Serialize(Model.REQMENU));
                var adminId = @Html.Raw(Json.Serialize(Model.RESUSERID));
                getReqMenuDropdown(reqMenuValue, systemcd, adminId);
            };

        // 시스템 선택 시 메뉴 드롭다운 변경
            $('#SYSTEMCD').on('change', function() {
                var systemCodeId = $(this).val();
                var reqMenuDropdown = $('#ReqMenu');

                reqMenuDropdown.empty();
                reqMenuDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectMenu"])'));

                if (systemCodeId) {
                    $.ajax({
                        url: '@Url.Action("GetMenusBySystemCode", "CommCode")',
                        type: 'GET',
                        data: { systemCodeId: systemCodeId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                reqMenuDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // 메뉴 선택 시 조치자 드롭다운 변경
            // $('#ReqMenu').on('change', function() {
            //     var menuId = $(this).val();
            //     var adminDropdown = $('#RESUSERID');

            //     adminDropdown.empty();
            //     adminDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectActionTaker"])'));

            //     if (menuId) {
            //         $.ajax({
            //             url: '@Url.Action("GetAdminRel", "Req")',
            //             type: 'GET',
            //             data: { menuId: menuId },
            //             success: function(data) {
            //                 $.each(data, function(i, item) {
            //                     adminDropdown.append($('<option></option>').val(item.value).text(item.text));
            //                 });
            //             },
            //             error: function(xhr, status, error) {
            //                 console.error("An error occurred while fetching menus: " + error);
            //             }
            //         });
            //     }
            // });
        

        });


         // 메뉴 dropdown function
        const getReqMenuDropdown = function (reqMenuValue, systemCd, adminId){

            var reqMenuDropdown = $('#ReqMenu');

            reqMenuDropdown.empty();
            reqMenuDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectMenu"])'));

            $.ajax({
                url: '@Url.Action("GetMenusBySystemCode", "CommCode")',
                type: 'GET',
                data: { systemCodeId: systemCd },
                success: function(data) {
                    $.each(data, function(i, item) {
                        reqMenuDropdown.append($('<option></option>').val(item.value).text(item.text));
                    });

                    reqMenuDropdown.val(reqMenuValue);      

                    //getadminDropdown(adminId, reqMenuValue);
                },
                error: function(xhr, status, error) {
                    console.error("An error occurred while fetching menus: " + error);
                }
            });

        }

        // 조치자 dropdown function
        // const getadminDropdown = function( adminId, menuId ){
            
        //     var adminDropdown = $('#RESUSERID');

        //     adminDropdown.empty();
        //     adminDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectActionTaker"])'));

        //     if (menuId) {
        //         $.ajax({
        //             url: '@Url.Action("GetAdminRel", "Req")',
        //             type: 'GET',
        //             data: { menuId: menuId },
        //             success: function(data) {
        //                 $.each(data, function(i, item) {
        //                     adminDropdown.append($('<option></option>').val(item.value).text(item.text));
        //                 });

        //                 adminDropdown.val(adminId);
        //             },
        //             error: function(xhr, status, error) {
        //                 console.error("An error occurred while fetching menus: " + error);
        //             }
        //         });
        //     }

        // }

        // 사용자 검색 기능 초기화
        function initializeUserSearch() {

            $("#userSearchDataGrid").dxDataGrid({
                dataSource: [], // Initialize with an empty array
                remoteOperations: false, // Set to false for client-side operations
                columns: [
                    { dataField: "userId", caption: '@Html.Raw(SharedLocalizer["Label_UserId"])' },
                    { dataField: "userName", caption: '@Html.Raw(SharedLocalizer["Label_UserName"])' },
                    { dataField: "corpName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_CorpName"])' },
                    { dataField: "deptName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_DeptName"])' },
                    { dataField: "officeName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_OfficeName"])' },
                    { dataField: "teamName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_TeamName"])' },
                    { dataField: "emailAddr", caption: '@Html.Raw(SharedLocalizer["Label_Email"])' },
                    { dataField: "mobPhoneNo", caption: '@Html.Raw(SharedLocalizer["Label_Contact"])' }
                ],
                selection: {
                    mode: "single"
                },
                hoverStateEnabled: true,
                showBorders: true,
                showRowLines: true,
                filterRow: {
                    visible: true,
                    applyFilter: "auto"
                },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: '@Html.Raw(SharedLocalizer["DataGrid_SearchUser"])'
                },
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [5, 10, 20],
                    showInfo: true
                },
                onSelectionChanged: function(selectedItems) {
                    var data = selectedItems.selectedRowsData[0];
                    if (data) {
                        // Hidden fields
                        $('input[name="CORCD"]').val(data.corCd);
                        $('input[name="DEPTCD"]').val(data.deptCd);
                        $('input[name="OFFICECD"]').val(data.officeCd);
                        $('input[name="TEAMCD"]').val(data.teamCd);
                        $('input[name="REG_USERID"]').val(data.userId); // Assuming Req and Reg user are the same if selected
                        $('input[name="REQUSERID"]').val(data.userId);

                        // Display fields
                        $('input[name="ReqUserName"]').val(data.userName);
                        $('input[name="ReqUserEmail"]').val(data.emailAddr);
                        $('input[name="ReqUserTel"]').val(data.mobPhoneNo);

                        // Update organization display
                        var orgParts = [data.corpName, data.deptName, data.officeName, data.teamName].filter(p => p);
                        $('input[name="organization"]').val(orgParts.join(" / ")); // Update the organization field.

                        userSearchPopup.hide();
                    }
                }
            });

            var userSearchPopup = $("#userSearchPopup").dxPopup({
                width: 900,
                height: 600,
                title: '@Html.Raw(SharedLocalizer["Popup_SelectUser"])',
                showTitle: true,
                dragEnabled: false,
                closeOnOutsideClick: true,
                visible: false,
                toolbarItems: [{
                    widget: 'dxButton',
                    toolbar: 'bottom',
                    location: 'after',
                    options: {
                        text: '@Html.Raw(SharedLocalizer["Button_Close"])',
                        onClick: function() {
                            userSearchPopup.hide();
                        }
                    }
                }]
            }).dxPopup("instance");

            $("#btnSearchUser").dxButton({
                text: '@Html.Raw(SharedLocalizer["Button_SearchUser"])',
                type: 'default',
                onClick: function() {
                    userSearchPopup.show();
                    // Fetch all users and set as data source
                    $.ajax({
                        url: '@Url.Action("SearchUsersJson", "User")',
                        type: 'GET',
                        data: { searchText: '' }, // Initially load all users. SearchPanel will filter client-side.
                        success: function(data) {
                            $("#userSearchDataGrid").dxDataGrid("instance").option("dataSource", data);
                        },
                        error: function(xhr, status, error) {
                            console.error("사용자 목록을 불러오는 중 오류 발생: " + error);
                            DevExpress.ui.notify(`사용자 목록을 불러오는 데 실패했습니다: ${error}`, "error", 2000);
                        }
                    });
                }
            });
        }

        $(document).ready(function() {
            initializeUserSearch();

            // 상단 저장 버튼 클릭 시 폼 제출
            $('#btnSaveTop').on('click', function () {
                $('#answerForm').submit();
            });

            // "목록" 버튼 클릭 시 저장된 검색 조건이 있으면 해당 주소로 이동
            $('.btn-list').on('click', function (e) {
                var lastSearch = sessionStorage.getItem('reqLastSearch');
                if (lastSearch) {
                    e.preventDefault();

                    window.location.href = '@Url.Action("Index", "Req")' + lastSearch;

                    // if(userDiv == "R3" || userDiv == "R4"){
                    //     window.location.href = '@Url.Action("Indexgrid", "Req")' + lastSearch;
                    // }else{
                    //     window.location.href = '@Url.Action("Index", "Req")' + lastSearch;
                    // }
                    
                }
            });
        });


        function validateForm() {
            // 1. 제목 필수 체크
            if (!$('#TITLE').val().trim()) {
                alert('@Html.Raw(SharedLocalizer["Validation_Required_Title"] ?? "제목을 입력해 주세요.")');
                $('#TITLE').focus();
                return false;
            }
            // REQTYPE 요청유형형
            if (!$('#REQTYPE').val()) {
                alert('@Html.Raw(SharedLocalizer["요청유형을 선택해주세요"])');
                $('#REQTYPE').focus();
                return false;
            }

            // 2. 시스템 필수 체크
            if (!$('#SYSTEMCD').val()) {
                alert('@Html.Raw(SharedLocalizer["Validation_Required_System"] ?? "시스템을 선택해 주세요.")');
                $('#SYSTEMCD').focus();
                return false;
            }
            // 3. 처리 상태 필수 체크
            if (!$('#PROC_STATUS').val()) {
                alert('@Html.Raw(SharedLocalizer["Validation_Required_Status"] ?? "처리 상태를 선택해 주세요.")');
                $('#PROC_STATUS').focus();
                return false;
            }

            // 3. 처리 상태 필수 체크
            if (!$('#RESUSERID').val()) {
                alert('@Html.Raw(SharedLocalizer["조치자를 선택해주세요"])');
                $('#RESUSERID').focus();
                return false;
            }

            return true;

        }


    </script>
}
