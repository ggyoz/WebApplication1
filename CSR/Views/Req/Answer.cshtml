@model ReqInfo
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Authorization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "요구사항 수정";
}

<partial name="_PageTitlePartial" />

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Answer" asp-route-id="@Model.REQID" enctype="multipart/form-data">
            <input type="hidden" asp-for="REQID" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <table class="table-layout" width="100%; min-width:600px;">
                <colgroup>
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                </colgroup>
                <tbody>
                    <tr>    
                        <td><label asp-for="ReqUserName" class="control-label">요청자 이름</label></td>                    
                        <td><input asp-for="ReqUserName" class="form-control" /></td>
                        <td><label asp-for="REQDATE" class="control-label"></label></td>
                        <td><input asp-for="REQDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="DUEDATE" class="control-label"></label></td>
                        <td><input asp-for="DUEDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="EXPECTDATE" class="control-label"></label></td>
                        <td><input asp-for="EXPECTDATE" type="date" class="form-control" /></td>
                    </tr>                    
                     <tr>
                        <td><label asp-for="STARTDATE" class="control-label"></label></td>
                        <td><input asp-for="STARTDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="ENDDATE" class="control-label"></label></td>
                        <td><input asp-for="ENDDATE" type="date" class="form-control" /></td>
                        <td><label asp-for="MAN_DAY" class="control-label"></label></td>
                        <td><input asp-for="MAN_DAY" type="number" step="0.5" class="form-control" min="0" max="100" oninput="enforceMinMaxValue(this)" /></td>                        
                    </tr>
                    <tr>
                        <td><label asp-for="REQTYPE" class="control-label"></label></td>
                        <td><select asp-for="REQTYPE" asp-items="ViewBag.ReqTypes" class="form-select"></select></td>
                        <td><label asp-for="SYSTEMCD" class="control-label"></label></td>
                        <td><select asp-for="SYSTEMCD" asp-items="ViewBag.SystemCodes" class="form-select"></select></td>
                        <td><label asp-for="REQMENU" class="control-label"></label></td>
                        <td><select asp-for="REQMENU" id="ReqMenu" asp-items="ViewBag.SystemCodes" class="form-select"></select></td>
                        <td><label asp-for="RESUSERID" class="control-label"></label></td>
                        <td><input asp-for="RESUSERID" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td><label asp-for="PRIORITYCD" class="control-label"></label></td>
                        <td><select asp-for="PRIORITYCD" asp-items="ViewBag.PriorityCodes" class="form-select"></select>
                        <td><label asp-for="IMPTCD" class="control-label"></label></td>
                        <td><select asp-for="IMPTCD" asp-items="ViewBag.ImportantCodes" class="form-select"></select>
                        <td><label asp-for="DFCLTCD" class="control-label"></label></td>
                        <td><select asp-for="DFCLTCD" asp-items="ViewBag.difficultCodes" class="form-select"></select>
                        </td><td><label asp-for="PROC_STATUS" class="control-label"></label></td>
                        <td><select asp-for="PROC_STATUS" asp-items="ViewBag.ProcStatusCodes" class="form-select"></select></td>                        
                    </tr>
                    <tr>
                        <td><label asp-for="REQTCODE" class="control-label"></label></td>
                        <td><input asp-for="REQTCODE" class="form-control" /></td>
                        <td><label asp-for="RESTCODE" class="control-label"></label></td>
                        <td><input asp-for="RESTCODE" class="form-control" /></td>
                        <td><label asp-for="BXTID" class="control-label"></label></td>
                        <td><input asp-for="BXTID" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td><label asp-for="TITLE" class="control-label"></label></td>
                        <td colspan="7">
                            <input asp-for="TITLE" class="form-control" />
                            <span asp-validation-for="TITLE" class="text-danger"></span>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;"><label asp-for="CONTENTS_HTML" class="control-label"></label></td>
                        <td colspan="7">
                            <div id="content-editor"></div>
                            <input type="hidden" asp-for="CONTENTS_HTML" />
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;"><label asp-for="ANSWER_HTML" class="control-label"></label></td>
                        <td colspan="7">
                            <div id="answer-editor"></div>
                            <input type="hidden" asp-for="ANSWER_HTML" />
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;"><label asp-for="NOTE_HTML" class="control-label"></label></td>
                        <td colspan="7">
                            <div id="note-editor"></div>
                            <input type="hidden" asp-for="NOTE_HTML" />
                        </td>

                        
                    </tr>
                    <tr>
                        <td>@SharedLocalizer["Label_Attachments"]</td>
                        <td colspan="7">
                            @if (Model.AttachFiles.Any())
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var file in Model.AttachFiles)
                                    {
                                        <li class="list-group-item">
                                            <input type="checkbox" name="deletedFiles" value="@file.FILEID" id="del-@file.FILEID" class="form-check-input" />
                                            <label for="del-@file.FILEID" class="form-check-label ms-2">@SharedLocalizer["Button_Delete"]</label>
                                            <a asp-action="DownloadFile" asp-route-id="@file.FILEID" class="ms-3">@file.REAL_FILENAME</a>
                                        </li>
                                    }
                                </ul>
                            }
                            <div>
                                <div id="file-uploader"></div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="button-area text-end mt-5 m-3">
                <input type="submit" value="@SharedLocalizer["Button_Save"]" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.REQID" class="btn btn-secondary">@SharedLocalizer["Button_Cancel"]</a>
                <a asp-action="Index" class="btn btn-list">@SharedLocalizer["Button_List"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        #file-uploader .dx-fileuploader-input-wrapper { min-height: 150px; border: 2px dashed #ccc; padding: 20px; background-color: #f8f9fa; }
    </style>
    <script>
        $(function() {
            initializeHtmlEditor('#content-editor', 'input[name="@Html.NameFor(m => m.CONTENTS_HTML)"]');
            initializeHtmlEditor('#answer-editor', 'input[name="@Html.NameFor(m => m.ANSWER_HTML)"]');
            initializeHtmlEditor('#note-editor', 'input[name="@Html.NameFor(m => m.NOTE_HTML)"]');

            $("#file-uploader").dxFileUploader({
                name: 'newFiles',
                multiple: true,
                uploadMode: 'useForm'
            });
        });
    </script>
}
