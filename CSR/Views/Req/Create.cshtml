@model ReqInfo
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Authorization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = SharedLocalizer["Title_CreateReq"];
}

<partial name="_PageTitlePartial" />

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" enctype="multipart/form-data" id="reqCreateForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="CORCD" />
            <input type="hidden" asp-for="DEPTCD" />
            <input type="hidden" asp-for="OFFICECD" />
            <input type="hidden" asp-for="TEAMCD" />
            <input type="hidden" asp-for="REG_USERID" />
            <input type="hidden" asp-for="REQUSERID" />
            
            <table class="table-create" width="100%">
                <colgroup>
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                </colgroup>
                <tbody>
                    <tr>
                        <th><label>@SharedLocalizer["Label_Requester"]</label></th>
                        <td>
                            <div class="d-flex">
                                <input asp-for="ReqUserName" class="form-control" readonly />
                                @if( (await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded ){
                                    <div style="width:30%" id="btnSearchUser" class="ms-2"></div>
                                }
                            </div>
                            <span asp-validation-for="ReqUserName" class="text-danger"></span>
                        </td>
                        <th><label>@SharedLocalizer["Label_Affiliation"]</label></th>
                        <td>
                            @{
                                var orgParts = new[] { Model.CorpName, Model.DeptName, Model.OfficeName, Model.TeamName };
                                var organization = string.Join(" / ", orgParts.Where(p => !string.IsNullOrEmpty(p)));
                            }
                            <input type="text" class="form-control" name="organization" value="@organization" id="organization" readonly />
                        </td>

                        <th><label>@SharedLocalizer["Label_Email"]</label></th>
                        <td>
                            <input asp-for="ReqUserEmail" class="form-control" readonly />
                            <span asp-validation-for="ReqUserEmail" class="text-danger"></span>
                        </td>
                        <th><label>@SharedLocalizer["Label_Contact"]</label></th>
                        <td>
                            <input asp-for="ReqUserTel" class="form-control" readonly />
                            <span asp-validation-for="ReqUserTel" class="text-danger"></span>
                        </td>
                    </tr>
                    <tr>
                        <th><label class="control-label">@SharedLocalizer["Label_RequestType"]</label></th>
                        <td>
                            <select asp-for="REQTYPE" asp-items="ViewBag.ReqTypes" class="form-select">
                            <option value="">@SharedLocalizer["Placeholder_SelectRequestType"]</option>
                            </select>
                            <span asp-validation-for="REQTYPE" class="text-danger"></span>
                        </td>
                        <th><label class="control-label">@SharedLocalizer["Label_SystemCode"]</label></th>
                        <td>
                            <select asp-for="SYSTEMCD" asp-items="ViewBag.SystemCodes" class="form-select">
                                <option value="">@SharedLocalizer["Placeholder_SelectSystem"]</option>
                            </select>
                            <span asp-validation-for="SYSTEMCD" class="text-danger"></span>
                        </td>
                        <th><label class="control-label">@SharedLocalizer["Label_RequestMenu"]</label></th>
                        <td>
                            <select asp-for="REQMENU" id="ReqMenu" class="form-select"></select>
                            <span asp-validation-for="REQMENU" class="text-danger"></span>
                        </td>
                        <th><label class="control-label">@SharedLocalizer["Label_ActionTaker"]</label></th>
                        <td>
                            <select asp-for="RESUSERID" class="form-select"></select>
                            <span asp-validation-for="RESUSERID" class="text-danger"></span>
                        </td>
                    </tr>
                    
                    <tr>
                        <th><label class="control-label">@SharedLocalizer["Label_RequestDate"]</label></th>
                        <td>
                            <div id="ReqDate"></div>
                            <input asp-for="REQDATE" type="hidden" class="form-control" id="hiddenReqDate" />
                            <span asp-validation-for="REQDATE" class="text-danger"></span>
                        </td>
                        <th><label class="control-label">@SharedLocalizer["Label_DueDate"]</label></th>
                        <td>
                            <div id="DueDate"></div>                            
                            <input asp-for="DUEDATE" type="hidden" class="form-control" id="hiddenDueDate"/>                            
                            <span asp-validation-for="DUEDATE" class="text-danger"></span>
                            <div class="mt-1"><i class="bi bi-caret-right-fill"></i> <small class="text-muted">완료요청일은 요청일 기준 D+5일 이후로 작성 부탁드립니다.</small></div>
                        </td>
                        <th><label class="control-label">@SharedLocalizer["Label_Urgency"]</label></th>
                        <td>
                            <select asp-for="PRIORITYCD" asp-items="ViewBag.PriorityCodes" class="form-select">
                            <option value="">@SharedLocalizer["Placeholder_SelectUrgency"]</option>
                            </select>
                            <span asp-validation-for="PRIORITYCD" class="text-danger"></span>
                        </td>  
                        <th><label class="control-label">@SharedLocalizer["Label_Tcode"]</label></th>
                        <td>
                            <input asp-for="REQTCODE" type="text" class="form-control" maxlength="16" />
                            <span asp-validation-for="REQTCODE" class="text-danger"></span>
                        </td> 
                    </tr>

                    <tr>
                        <th><label class="control-label">@SharedLocalizer["Label_Title"]</label></th>
                        <td colspan="7">
                            <input asp-for="TITLE" class="form-control" maxlength="100" />
                            <span asp-validation-for="TITLE" class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <th style="vertical-align: top;">
                            <label class="control-label">@SharedLocalizer["Label_Content"]</label>
                        </th>
                        <td colspan="7">
                            <span asp-validation-for="CONTENTS_HTML" class="text-danger"></span>
                            <div class="html-editor"></div>
                            <input type="hidden" asp-for="CONTENTS_HTML" value="
                            <p><strong style='font-size:20px;'><내용 작성가이드></strong></p>
                            <p>--------------------------------------------------------</p>
                            <p><span style='font-size:16px;'>※ 요청사항은 팀내에서 논의된 내용만 입력 부탁드립니다.</span></p>
                            <p><span style='font-size:16px;'>※ Excel 데이터 업로드에서 오류가 발생한 경우 Excel 파일을 첨부해주세요.</span></p>
                            <p>--------------------------------------------------------</p>
                            <p><span style='font-size:16px;'>1. 작업 메뉴 &nbsp;&nbsp;:</span></p>
                            <p></p>
                            <p><span style='font-size:16px;'>2. 조회 조건 &nbsp;&nbsp;:</p>
                            <p></p>
                            <p><span style='font-size:16px;'>3. 요청 내용 &nbsp;&nbsp;:</p>
                            <p></p>
                            <p><span style='font-size:16px;'>4. 현상 및 문제점 :</p>
                            <p></p>
                            <p><span style='font-size:16px;'>5. 샘플데이터 :</p>
                            "/>
                        </td>
                    </tr>                    
                    <tr>
                        <th><label class="control-label">@SharedLocalizer["Label_Attachments"]</label></th>
                        <td colspan="7">
                            <div>
                                <div id="file-uploader"></div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="button-area text-end mt-5 m-3">
                <input type="submit" value="@SharedLocalizer["Button_Save"]" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-list">@SharedLocalizer["Button_List"]</a>
            </div>

            <div id="userSearchPopup">
                <div id="userSearchDataGrid"></div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <style>
        .table-create {            
            border-top:1px solid #ccc;
            border-bottom: 1px solid #ccc;
            margin-bottom: 20px;
            width: 100%;
        }
        .table-create th {
            background-color: #f8f9fa;
            color: #333;
            font-weight: bold;
            padding: 12px 10px;
            border-bottom: 1px solid #e2e8f0;
            text-align: right;
            vertical-align: middle;
        }
        .table-create td {
            padding: 8px 10px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }
        .table-create .form-control, .table-create .form-select {
            border-radius: 4px;
        }
        #file-uploader .dx-fileuploader-input-wrapper {
            min-height: 150px;
            border: 2px dashed #ccc;
            padding: 20px;
            background-color: #f8f9fa;
        }
        .html-editor .dx-htmleditor-content {
            white-space: normal; /* 텍스트가 자동으로 줄 바꿈되도록 설정 */
            word-break: break-word; /* 긴 단어도 줄 바꿈되도록 설정 */
            background-color:#ffffff;
        }

         @* 이미지 넘침 방지 *@
        .dx-htmleditor-content img{
            max-width: 100%;
            height: auto;
            display: block;
            margin-bottom: 10px;
        }
        
    </style>

    <script>
        $(function() {

            var today = new Date();
            var after5day = new Date();
            after5day.setDate(today.getDate() + 5);

            initDateBox('#ReqDate', '#hiddenReqDate', today);
            initDateBox('#DueDate', '#hiddenDueDate', after5day);

            initializeHtmlEditor(
                '.html-editor',
                'input[name="@Html.NameFor(m => m.CONTENTS_HTML)"]',
                null 
            );

            $("#file-uploader").dxFileUploader({ 
                name: 'files',
                multiple: true,
                uploadMode: 'useForm',
                allowCanceling: true,
                maxFileSize: 4000000, // 4mb
                onValueChanged: function (e) {                    
                    const maxLength = 250; // 최대 허용 길이
                    const files = e.value;                
                    files.forEach(file => {
                        if (file.name.length > maxLength) {
                            // 경고 메시지 표시
                            DevExpress.ui.notify(`@Html.Raw(SharedLocalizer["Validation_FileNameTooLong", 250])`, "error", 2000);
                            // 필요 시 컴포넌트 값 초기화
                            e.component.reset();
                        }
                    });
                }                
            });

            $('#reqCreateForm').on('submit', function (e) {
                const fields = [
                    { id: '#REQTYPE', label: '@Html.Raw(SharedLocalizer["Label_RequestType"])' },
                    { id: '#SYSTEMCD', label: '@Html.Raw(SharedLocalizer["Label_SystemCode"])' },
                    { id: '#ReqMenu', label: '@Html.Raw(SharedLocalizer["Label_RequestMenu"])' },
                    { id: '#RESUSERID', label: '@Html.Raw(SharedLocalizer["Label_ActionTaker"])' },
                    { id: '#hiddenReqDate', label: '@Html.Raw(SharedLocalizer["Label_RequestDate"])' },
                    { id: '#hiddenDueDate', label: '@Html.Raw(SharedLocalizer["Label_DueDate"])' },
                    { id: '#PRIORITYCD', label: '@Html.Raw(SharedLocalizer["Label_Urgency"])' },
                    { id: 'input[name="TITLE"]', label: '@Html.Raw(SharedLocalizer["Label_Title"])' }
                ];

                for (const field of fields) {
                    const $el = $(field.id);
                    if (!$el.val() || $el.val().trim() === "") {
                        DevExpress.ui.notify(field.label + " @Html.Raw(SharedLocalizer["Validation_Required"])", "error", 3000);
                        $el.focus();
                        e.preventDefault();
                        return false;
                    }
                }

                // HTML Editor (Contents) 검증
                const contents = $('input[name="CONTENTS_HTML"]').val();
                if (!contents || contents === "" || contents === "<p><br></p>") {
                    const msg = "@Html.Raw(SharedLocalizer["Label_Content"]) @Html.Raw(SharedLocalizer["Validation_Required"])";
                    DevExpress.ui.notify(msg, "error", 3000);
                    $('.html-editor').focus();
                    e.preventDefault();
                    return false;
                }

                return true;
            });

            // 시스템 선택 시 메뉴 드롭다운 변경
            $('#SYSTEMCD').on('change', function() {
                var systemCodeId = $(this).val();
                var reqMenuDropdown = $('#ReqMenu');

                reqMenuDropdown.empty();
                reqMenuDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectMenu"])'));

                if (systemCodeId) {
                    $.ajax({
                        url: '@Url.Action("GetMenusBySystemCode", "CommCode")',
                        type: 'GET',
                        data: { systemCodeId: systemCodeId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                reqMenuDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // 메뉴 선택 시 조치자 드롭다운 변경
            $('#ReqMenu').on('change', function() {
                var menuId = $(this).val();
                var adminDropdown = $('#RESUSERID');

                adminDropdown.empty();
                adminDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectActionTaker"])'));

                if (menuId) {
                    $.ajax({
                        url: '@Url.Action("GetAdminRel", "Req")',
                        type: 'GET',
                        data: { menuId: menuId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                adminDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });
        });

        // 사용자 검색 기능 초기화
        function initializeUserSearch() {

            $("#userSearchDataGrid").dxDataGrid({
                dataSource: [], // Initialize with an empty array
                remoteOperations: false, // Set to false for client-side operations
                columns: [
                    { dataField: "userId", caption: '@Html.Raw(SharedLocalizer["Label_UserId"])' },
                    { dataField: "userName", caption: '@Html.Raw(SharedLocalizer["Label_UserName"])' },
                    { dataField: "corpName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_CorpName"])' },
                    { dataField: "deptName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_DeptName"])' },
                    { dataField: "officeName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_OfficeName"])' },
                    { dataField: "teamName", caption: '@Html.Raw(SharedLocalizer["Label_Affiliation_TeamName"])' },
                    { dataField: "emailAddr", caption: '@Html.Raw(SharedLocalizer["Label_Email"])' },
                    { dataField: "mobPhoneNo", caption: '@Html.Raw(SharedLocalizer["Label_Contact"])' }
                ],
                selection: {
                    mode: "single"
                },
                hoverStateEnabled: true,
                showBorders: true,
                showRowLines: true,
                filterRow: {
                    visible: true,
                    applyFilter: "auto"
                },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: '@Html.Raw(SharedLocalizer["DataGrid_SearchUser"])'
                },
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [5, 10, 20],
                    showInfo: true
                },
                onSelectionChanged: function(selectedItems) {
                    var data = selectedItems.selectedRowsData[0];
                    if (data) {
                        // Hidden fields
                        $('input[name="CORCD"]').val(data.corCd);
                        $('input[name="DEPTCD"]').val(data.deptCd);
                        $('input[name="OFFICECD"]').val(data.officeCd);
                        $('input[name="TEAMCD"]').val(data.teamCd);
                        $('input[name="REG_USERID"]').val(data.userId); // Assuming Req and Reg user are the same if selected
                        $('input[name="REQUSERID"]').val(data.userId);

                        // Display fields
                        $('input[name="ReqUserName"]').val(data.userName);
                        $('input[name="ReqUserEmail"]').val(data.emailAddr);
                        $('input[name="ReqUserTel"]').val(data.mobPhoneNo);

                        // Update organization display
                        var orgParts = [data.corpName, data.deptName, data.officeName, data.teamName].filter(p => p);
                        $('input[name="organization"]').val(orgParts.join(" / ")); // Update the organization field.

                        userSearchPopup.hide();
                    }
                }
            });

            var userSearchPopup = $("#userSearchPopup").dxPopup({
                width: 900,
                height: 600,
                title: '@Html.Raw(SharedLocalizer["Popup_SelectUser"])',
                showTitle: true,
                dragEnabled: false,
                closeOnOutsideClick: true,
                visible: false,
                toolbarItems: [{
                    widget: 'dxButton',
                    toolbar: 'bottom',
                    location: 'after',
                    options: {
                        text: '@Html.Raw(SharedLocalizer["Button_Close"])',
                        onClick: function() {
                            userSearchPopup.hide();
                        }
                    }
                }]
            }).dxPopup("instance");

            $("#btnSearchUser").dxButton({
                text: '@Html.Raw(SharedLocalizer["Button_SearchUser"])',
                type: 'default',
                onClick: function() {
                    userSearchPopup.show();
                    // Fetch all users and set as data source
                    $.ajax({
                        url: '@Url.Action("SearchUsersJson", "User")',
                        type: 'GET',
                        data: { searchText: '' }, // Initially load all users. SearchPanel will filter client-side.
                        success: function(data) {
                            $("#userSearchDataGrid").dxDataGrid("instance").option("dataSource", data);
                        },
                        error: function(xhr, status, error) {
                            console.error("사용자 목록을 불러오는 중 오류 발생: " + error);
                            DevExpress.ui.notify(`사용자 목록을 불러오는 데 실패했습니다: ${error}`, "error", 2000);
                        }
                    });
                }
            });
        }
        
        $(document).ready(function() {
            initializeUserSearch();

            // "목록" 버튼 클릭 시 저장된 검색 조건이 있으면 해당 주소로 이동
            $('.btn-list').on('click', function (e) {
                var lastSearch = sessionStorage.getItem('reqLastSearch');
                if (lastSearch) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("Index", "Req")' + lastSearch;
                }
            });
        });

    </script>
}
