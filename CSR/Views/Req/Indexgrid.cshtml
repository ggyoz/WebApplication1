<div class="card search-area">
    <form asp-action="Index" method="get">
        <div class="card-body">
            <!-- 상단 검색 영역 (항상 노출) -->
            <div class="row g-3">

                <div class="col-12 col-md-4 col-xl-2">
                    <label class="form-label fw-bold">@SharedLocalizer["Label_RequestNo"]</label>
                    <input name="RegId" class="form-control" value="@ViewData["RegId"]" maxLength="10" />
                </div>
                <div class="col-12 col-md-8 col-xl-4">
                    <label class="form-label fw-bold">@SharedLocalizer["Label_Title"]</label>
                    <input type="text" name="searchValue" value="@ViewData["SearchValue"]" class="form-control" maxLength="50"/>
                </div>
                <div class="col-12 col-md-4 col-xl-2">
                    <label class="form-label fw-bold">TCODE</label>
                    <input name="Tcode" class="form-control" value="@ViewData["Tcode"]" maxLength="15" />
                </div>
                <div class="col-12 col-md-4 col-xl-2">
                    <label class="form-label fw-bold">@SharedLocalizer["Label_Requester"]</label>
                    <input name="ReqUserName" class="form-control" value="@ViewData["ReqUserName"]" maxLength="10" />
                </div>
                <div class="col-12 col-md-4 col-xl-2">
                    <label class="form-label fw-bold">@SharedLocalizer["Label_ActionTaker"]</label>
                    <input name="ResUserName" class="form-control" value="@ViewData["ResUserName"]" maxLength="10" />
                </div>                
            </div>

            <!-- 하단 상세 검색 영역 (접기/펴기) -->
            <div class="collapse mt-3 hide" id="searchCollapse">
                <div class="row g-3">
                    
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_RequestDate"]</label>
                        <div id="ReqDateSearch"></div><input type="hidden" name="ReqDate" id="hiddenReqDate" />
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_DueDate"]</label>
                        <div id="DueDateSearch"></div><input type="hidden" name="DueDate" id="hiddenDueDate" />
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_ExpectedCompletionDate"]</label>
                        <div id="ExpectDateSearch"></div><input type="hidden" name="ExpectDate" id="hiddenExpectDate" />
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_RequestType"]</label>
                        <select asp-items="ViewBag.ReqTypes" class="form-select" name="ReqTypeCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectRequestType"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["종결여부"]</label>
                        <select class="form-select" name="terminateYn">
                            <option value="">선택</option>
                            <option value="N">진행중</option>
                            <option value="Y">종결</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_ProgressStatus"]</label>
                        <select asp-items="ViewBag.ProcStatusCodes" class="form-select" name="ProcStatusCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectProgressStatus"]</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_Corporation"]</label>
                        <select id="CorCd" asp-items="ViewBag.CorCdList" class="form-select" name="CorCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectCorporation"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_Department"]</label>
                        <select id="DeptCd" class="form-select" name="DeptCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectDepartment"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_Office"]</label>
                        <select id="OfficeCd" class="form-select" name="OfficeCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectOffice"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_Team"]</label>
                        <select id="TeamCd" class="form-select" name="TeamCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectTeam"]</option>
                        </select>
                    </div>

                    
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_Urgency"]</label>
                        <select asp-items="ViewBag.PriorityCodes" class="form-select" name="PriorityCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectUrgency"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_Importance"]</label>
                        <select asp-items="ViewBag.ImportanceCodes" class="form-select" name="ImportanceCd">
                            <option value="">@SharedLocalizer["Placeholder_SelectImportance"]</option>
                        </select>
                    </div>

                    <div class="col-12 mt-3">
                        <label class="form-label fw-bold">@SharedLocalizer["Label_ResponsibleArea"]</label>
                        <div class="border rounded p-3 bg-light">
                            @{
                                var allResponsibilities = ViewBag.AllResponsibilities as Dictionary<string, List<CSR.Models.CommCode>> ?? new Dictionary<string, List<CSR.Models.CommCode>>();
                                var selectedResponsibilities = ViewData["AssignedResponsibilities"] as List<string> ?? new List<string>();
                            }
                            <input type="hidden" name="AssignedResponsibilities" id="hiddenAssignedResponsibilities" value="@string.Join(",", selectedResponsibilities)" />
                            @foreach (var group in allResponsibilities)
                            {
                                <div class="mb-3 resp-group-container">
                                    <div class="form-check">
                                        <input class="form-check-input select-all-group" type="checkbox" id="group_@group.Key.GetHashCode()">
                                        <label class="form-check-label fw-bold" for="group_@group.Key.GetHashCode()">@group.Key</label>
                                    </div>
                                    <div class="d-flex flex-wrap gap-3 ms-4 mt-1">
                                        @foreach (var responsibility in group.Value)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input resp-checkbox" type="checkbox" value="@responsibility.CODEID" id="resp_@responsibility.CODEID"
                                                    @(selectedResponsibilities.Contains(responsibility.CODEID.ToString()) ? "checked" : "") />
                                                <label class="form-check-label" for="resp_@responsibility.CODEID">@SharedLocalizer[responsibility.CODENM]</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center mt-3">
                <div class="flex-grow-1 text-center">
                    <button type="button" class="btn btn-light" id="toggleSearchArea">
                        <i class="bi bi-chevron-bar-up" id="collapseIcon"></i>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary search-btn px-3">@SharedLocalizer["Label_Search"]</button>
            </div>
        </div>
    </form>
</div>


<div class="d-flex justify-content-between"> 
    <div class="text-start">
        <a href="#" id="btnExcelDownload" class="btn btn-excel" style="">@SharedLocalizer["Button_ExcelDown"]</a>
    </div>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-add">@SharedLocalizer["Button_RegisterRequest"]</a>
    </div>
</div>

<div id="SearchDataGrid" class="mt-3"></div>


@section Scripts {

    <style>
        .table-bordered th {
            display :flex;
            justify-content: center; /* Horizontally centers content */
            align-items: center;     /* Vertically centers content */
        }        
    </style>

    <script>

        const userDiv = '@HttpContextAccessor.HttpContext.User.FindFirst(ClaimTypes.Role)?.Value';            
        const userCorCd = '@Context.Session.GetString("CorCd")';
        const userDeptCd = '@Context.Session.GetString("DeptCd")'; 
        const userOfficeCd = '@Context.Session.GetString("OfficeCd")'; 
        const userTeamCd = '@Context.Session.GetString("TeamCd")'; 

        $(function () {

            if(userDiv != 'R3' && userDiv != 'R4' ){                
                $('select[name="CorCd"]').val(userCorCd);
                getDeptCode(userCorCd);
            }

            // Retrieve search values from ViewData
            const searchValues = {
                reqTypeCd: '@ViewData["ReqTypeCd"]',
                procStatusCd: '@ViewData["ProcStatusCd"]',
                priorityCd: '@ViewData["PriorityCd"]',
                reqDate: '@ViewData["ReqDate"]',
                dueDate: '@ViewData["DueDate"]',
                expectDate: '@ViewData["ExpectDate"]',
                CorCd: '@ViewData["CorCd"]',
                DeptCd: '@ViewData["DeptCd"]',
                OfficeCd: '@ViewData["OfficeCd"]',
                TeamCd: '@ViewData["TeamCd"]'                
            };
            
            if (searchValues.reqTypeCd) {
                $('select[name="ReqTypeCd"]').val(searchValues.reqTypeCd);
            }
            if (searchValues.procStatusCd) {
                $('select[name="ProcStatusCd"]').val(searchValues.procStatusCd);
            }
            if (searchValues.priorityCd) {
                $('select[name="PriorityCd"]').val(searchValues.priorityCd);
            }            
            if (searchValues.CorCd) {
                $('select[name="CorCd"]').val(searchValues.CorCd);
            }
            if (searchValues.DeptCd) {
                $('select[name="DeptCd"]').val(searchValues.DeptCd);
            }
            if (searchValues.OfficeCd) {
                $('select[name="OfficeCd"]').val(searchValues.OfficeCd);
            }
            if (searchValues.TeamCd) {
                $('select[name="TeamCd"]').val(searchValues.TeamCd);
            }            

            initDateBox('#ReqDateSearch', '#hiddenReqDate', searchValues.reqDate);
            initDateBox('#DueDateSearch', '#hiddenDueDate', searchValues.dueDate);
            initDateBox('#ExpectDateSearch', '#hiddenExpectDate', searchValues.expectDate);
            
            // DevExtreme DataGrid 초기화
            var grid = $("#SearchDataGrid").dxDataGrid({                
                dataSource: new DevExpress.data.CustomStore({
                    key: "reqid",                    
                    load: function(loadOptions) {
                        var d = $.Deferred();
                        var params = {};
                        
                        // DevExtreme Paging
                        params.skip = loadOptions.skip || 0;
                        params.take = loadOptions.take || 10;
                        
                        // DevExtreme Sorting
                        if (loadOptions.sort && loadOptions.sort.length > 0) {
                            params.sortColumn = loadOptions.sort[0].selector;
                            params.sortOrder = loadOptions.sort[0].desc ? "DESC" : "ASC";
                        }
                        
                        // Search Filters
                        $.extend(params, getSearchParams());

                        // 이 부분이 있어야 서버로 필터 조건이 전달됩니다!
                        if (loadOptions.filter) {
                            params.filter = JSON.stringify(loadOptions.filter);
                        }

                        $.ajax({
                            url: '/api/ReqApi/list',
                            data: params,
                            success: function(result) {
                                d.resolve(result.data, { totalCount: result.totalCount });
                            },
                            error: function() {
                                d.reject("Data Loading Error");
                            }
                        });
                        return d.promise();
                    }
                }),
                remoteOperations: {
                    paging: true,
                    sorting: true,
                    filtering: true // 필터링은 서버에 맡기지 않고 클라이언트 메모리에서 수행
                },
                stateStoring: {
                    enabled: true,
                    type: "localStorage",
                    storageKey: "reqIndexGridState"
                },
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                filterRow: {
                    visible: true,
                    //applyFilter: 'auto',
                },
                headerFilter: {
                    visible: true,
                },
                columns: [
                    { dataField: "reqid", caption: '@Html.Raw(SharedLocalizer["TableHeader_RequestNo"])', width: 80, alignment: "center" },
                    { 
                        dataField: "title", 
                        caption: '@Html.Raw(SharedLocalizer["TableHeader_Title"])',
                        width: 400,
                        cellTemplate: function(container, options) {
                            $('<a/>').addClass('grid-link')
                                .text(options.value)
                                .on('click', function() {
                                    window.location.href = '@Url.Action("Details", "Req")/' + options.data.reqid;
                                })
                                .appendTo(container);
                        }
                    },
                    { 
                        caption: '@Html.Raw(SharedLocalizer["TableHeader_Affiliation"])',
                        width: 250,
                        calculateCellValue: function(rowData) {
                            var orgParts = [rowData.corpName, rowData.teamName].filter(p => p);
                            return orgParts.join(" / ");
                        }
                    },
                    { dataField: "reqTypeName", caption: '@Html.Raw(SharedLocalizer["TableHeader_RequestClassification"])', alignment: "center", width: 100  },
                    { dataField: "systemName", caption: '@Html.Raw(SharedLocalizer["TableHeader_TargetSystem"])', alignment: "center", width: 80  },
                    { dataField: "reqMenuName", caption: '@Html.Raw(SharedLocalizer["TableHeader_RequestMenu"])', alignment: "center", width: 80 },
                    { dataField: "reqUserName", caption: '@Html.Raw(SharedLocalizer["TableHeader_Requester"])', alignment: "center" },
                    { 
                        dataField: "reqdate", 
                        caption: '@Html.Raw(SharedLocalizer["TableHeader_RequestDate"])', 
                        dataType: "date", 
                        format: "yyyy-MM-dd",
                        alignment: "center",
                        // 사용할 필터 연산자들 정의 (between이 날짜 검색에 매우 유용함)
                        filterOperations: ["=", "<", ">", "between"],
                        // 기본 선택될 연산자 (필요 시)
                        selectedFilterOperation: "between",
                        headerFilter: {
                            visible: true, // 헤더 필터(깔대기 모양) 활성화
                            // 헤더 필터 내에서 그룹화 방식 설정 (년/월 단위 등)
                            groupInterval: "month" 
                        }
                        
                    },
                    { dataField: "resUserName", caption: '@Html.Raw(SharedLocalizer["TableHeader_ActionTaker"])', alignment: "center", width: 100 },
                    { 
                        dataField: "duedate", 
                        caption: '@Html.Raw(SharedLocalizer["TableHeader_DueDate"])', 
                        dataType: "date", 
                        format: "yyyy-MM-dd",
                        alignment: "center"
                    },
                    { 
                        dataField: "expectdate", 
                        caption: '@Html.Raw(SharedLocalizer["TableHeader_ExpectedCompletionDate"])', 
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                var date = new Date(options.value);
                                var formattedDate = date.getFullYear() + '-' + 
                                    ('0' + (date.getMonth() + 1)).slice(-2) + '-' + 
                                    ('0' + date.getDate()).slice(-2);
                                container.text(formattedDate);
                            } else {
                                container.text('@Html.Raw(SharedLocalizer["Status_Undecided"])');
                            }
                        }
                    },
                    { dataField: "procStatusName", caption: '@Html.Raw(SharedLocalizer["TableHeader_ProgressStatus"])', alignment: "center", width: 80 }
                ],
                showBorders: true,
                showRowLines: true,
                hoverStateEnabled: true,
                rowAlternationEnabled: true,
                onRowClick: function(e) {
                    window.location.href = '@Url.Action("Details", "Req")/' + e.data.reqid;
                }
            }).dxDataGrid("instance");

            // 검색 조건 추출 함수
            function getSearchParams() {
                return {
                    reqTypeCd: $('select[name="ReqTypeCd"]').val(),
                    procStatusCd: $('select[name="ProcStatusCd"]').val(),
                    priorityCd: $('select[name="PriorityCd"]').val(),
                    reqDate: $('#hiddenReqDate').val(),
                    dueDate: $('#hiddenDueDate').val(),
                    expectDate: $('#hiddenExpectDate').val(),
                    corCd: $('select[name="CorCd"]').val(),
                    deptCd: $('select[name="DeptCd"]').val(),
                    officeCd: $('select[name="OfficeCd"]').val(),
                    teamCd: $('select[name="TeamCd"]').val(),
                    regId: $('input[name="RegId"]').val(),
                    reqUserName: $('input[name="ReqUserName"]').val(),
                    resUserName: $('input[name="ResUserName"]').val(),
                    searchValue: $('input[name="searchValue"]').val(),
                    tcode: $('input[name="Tcode"]').val(),
                    assignedResponsibilities: $('.resp-checkbox:checked').map(function() { return this.value; }).get().join(',')
                };
            }

            // 폼 제출 시 그리드 갱신
            $('form').on('submit', function(e) {
                e.preventDefault();
                grid.refresh();
            });

            // Excel Download Button Click Event
            $('#btnExcelDownload').on('click', function (e) {
                e.preventDefault();
                
                var params = getSearchParams();
                var currentParams = new URLSearchParams();
                for (var key in params) {
                    if (params[key]) currentParams.append(key, params[key]);
                }
                
                var exportUrl = '@Url.Action("ExportToExcel")' + '?' + currentParams.toString();
                window.location.href = exportUrl;
            });
            
            // Custom toggle logic using jQuery slideToggle
            $('#toggleSearchArea').on('click', function(e) {
                e.preventDefault();
                
                $('#searchCollapse').slideToggle(100, function() {
                    var icon = $('#collapseIcon');
                    if ($(this).is(':visible')) {
                        icon.removeClass('bi-chevron-bar-down').addClass('bi-chevron-bar-up');
                        localStorage.setItem('reqSearch_isExpanded', 'true');
                    } else {
                        icon.removeClass('bi-chevron-bar-up').addClass('bi-chevron-bar-down');
                        localStorage.setItem('reqSearch_isExpanded', 'false');
                    }
                });
            });

            // Set initial state based on localStorage
            const isExpanded = localStorage.getItem('reqSearch_isExpanded');
            if (isExpanded === 'true') {
                $('#searchCollapse').show();
                $('#collapseIcon').removeClass('bi-chevron-bar-down').addClass('bi-chevron-bar-up');
            } else {
                $('#searchCollapse').hide();
                $('#collapseIcon').removeClass('bi-chevron-bar-up').addClass('bi-chevron-bar-down');
            }
            
            // 법인 선택 시 메뉴 드롭다운 변경
            $('#CorCd').on('change', function() {
                var corCd = $(this).val();
                getDeptCode(corCd);
            });

            // 법인 선택 시 메뉴 드롭다운 변경
            $('#DeptCd').on('change', function() {
                var deptCd = $(this).val();
                getOfficeCode(deptCd);
            });
            
            // 법인 선택 시 메뉴 드롭다운 변경
            $('#OfficeCd').on('change', function() {
                var officeCd = $(this).val();
                getTeamCode(officeCd);
                
            });

            // 담당영역 그룹별 전체 선택/해제
            $('.select-all-group').on('change', function() {
                var isChecked = $(this).is(':checked');
                $(this).closest('.resp-group-container').find('.resp-checkbox').prop('checked', isChecked);
            });

            // 개별 체크박스 변경 시 상위 "전체 선택" 체크박스 상태 업데이트
            $('.resp-checkbox').on('change', function() {
                var container = $(this).closest('.resp-group-container');
                var total = container.find('.resp-checkbox').length;
                var checked = container.find('.resp-checkbox:checked').length;
                container.find('.select-all-group').prop('checked', total === checked);
            });

            // 페이지 로드 시 이미 모두 체크된 그룹은 "전체 선택" 활성화
            $('.resp-group-container').each(function() {
                var total = $(this).find('.resp-checkbox').length;
                var checked = $(this).find('.resp-checkbox:checked').length;
                if (total > 0 && total === checked) {
                    $(this).find('.select-all-group').prop('checked', true);
                }
            });

        }); // End of $(function)

        function getDeptCode(CorCd){
            var corCd = CorCd;
            var deptDropdown = $('#DeptCd');

            deptDropdown.empty();
            deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectDepartment"])'));

            if (corCd) {
                $.ajax({
                    url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                    type: 'GET',
                    data: { corCd: corCd, deptCd : "" },
                    success: function(data) {
                        $.each(data, function(i, item) {
                            deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                        });

                        if( userDiv != "R3" && userDiv != "R4" ){
                            $('select[name="DeptCd"]').val(userDeptCd);
                            getOfficeCode(userDeptCd);
                        }
                        
                    },
                    error: function(xhr, status, error) {
                        console.error("An error occurred while fetching menus: " + error);
                    }
                });
            }
        }

