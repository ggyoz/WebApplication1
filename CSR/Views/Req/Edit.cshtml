@model ReqInfo
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["Title_EditReq"];
}

<partial name="_PageTitlePartial" />

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" asp-route-id="@Model.REQID" enctype="multipart/form-data">

            <input type="hidden" asp-for="REQID" />
            <input type="hidden" asp-for="CORCD" />
            <input type="hidden" asp-for="DEPTCD" />
            <input type="hidden" asp-for="OFFICECD" />
            <input type="hidden" asp-for="TEAMCD" />
            <input type="hidden" asp-for="REG_USERID" />
            <input type="hidden" asp-for="REQUSERID" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <table class="table-layout">
                <colgroup>
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                    <col width="8%">
                    <col width="15%">
                </colgroup>
                <tbody>

                    <tr>
                        <td>@SharedLocalizer["Label_Requester"]</td>
                        <td>
                            <input asp-for="ReqUserName" class="form-control" readonly />
                            <span asp-validation-for="ReqUserName" class="text-danger"></span>
                        </td>
                        <td>@SharedLocalizer["Label_Affiliation"]</td>
                        <td>
                            @{
                                var orgParts = new[] { Model.CorpName, Model.DeptName, Model.OfficeName, Model.TeamName };
                                var organization = string.Join(" / ", orgParts.Where(p => !string.IsNullOrEmpty(p)));
                            }
                            <input type="text" class="form-control" value="@organization" readonly />
                        </td>

                        <td>@SharedLocalizer["Label_Email"]</td>
                        <td>
                            <input asp-for="ReqUserEmail" class="form-control" readonly />
                            <span asp-validation-for="ReqUserEmail" class="text-danger"></span>
                        </td>
                        <td>@SharedLocalizer["Label_Contact"]</td>
                        <td>
                            <input asp-for="ReqUserTel" class="form-control" readonly />
                            <span asp-validation-for="ReqUserTel" class="text-danger"></span>
                        </td>
                    </tr>
                    <tr>
                        <td><label class="control-label">@SharedLocalizer["Label_RequestType"]</label></td>
                        <td>
                            <select asp-for="REQTYPE" asp-items="ViewBag.ReqTypes" class="form-select">
                                <option>@SharedLocalizer["Placeholder_SelectRequestType"]</option>
                            </select>
                            <span asp-validation-for="REQTYPE" class="text-danger"></span>
                        </td>
                        <td><label class="control-label"></label></td>
                        <td>
                            <select asp-for="SYSTEMCD" asp-items="ViewBag.SystemCodes" class="form-select">
                                <option>@SharedLocalizer["Placeholder_SelectSystem"]</option>
                            </select>
                            <span asp-validation-for="SYSTEMCD" class="text-danger"></span>
                        </td>
                        <td><label class="control-label">@SharedLocalizer["Label_RequestMenu"]</label></td>
                        <td>
                            <select asp-for="REQMENU" id="ReqMenu" class="form-select"></select>                            
                        </td>
                        <td><label class="control-label">@SharedLocalizer["Label_ActionTaker"]</label></td>
                        <td>
                            <select asp-for="RESUSERID" class="form-select"></select>
                        </td>
                    </tr>
                    
                    <tr>
                        <td><label class="control-label">@SharedLocalizer["Label_RequestDate"]</label></td>
                        <td>
                            <input asp-for="REQDATE" type="date" class="form-control" />
                            <span asp-validation-for="REQDATE" class="text-danger"></span>
                        </td>
                        <td><label class="control-label">@SharedLocalizer["Label_DueDate"]</label></td>
                        <td>
                            <input asp-for="DUEDATE" type="date" class="form-control" />
                            <span asp-validation-for="DUEDATE" class="text-danger"></span>
                        </td>
                        <td><label class="control-label">@SharedLocalizer["Label_Urgency"]</label></td>
                        <td>
                            <select asp-for="PRIORITYCD" asp-items="ViewBag.PriorityCodes" class="form-select">
                                <option>@SharedLocalizer["Placeholder_SelectUrgency"]</option>
                            </select>
                            <span asp-validation-for="PRIORITYCD" class="text-danger"></span>
                        </td>  
                        <td><label class="control-label">@SharedLocalizer["Label_Tcode"]</label></td>
                        <td>
                            <input asp-for="REQTCODE" type="text" class="form-control" maxlength="10" />
                            <span asp-validation-for="REQTCODE" class="text-danger"></span>
                        </td> 
                    </tr>

                    <tr>
                        <td><label class="control-label">@SharedLocalizer["Label_Title"]</label></td>
                        <td colspan="7">
                            <input asp-for="TITLE" class="form-control" maxlength="150" />
                            <span asp-validation-for="TITLE" class="text-danger"></span>
                        </td>
                    </tr>
                    <tr>
                        <td><label class="control-label">@SharedLocalizer["Label_ProgressStatus"]</label></td>
                        <td>
                            <select asp-for="PROC_STATUS" asp-items="ViewBag.ProcStatusCodes" class="form-select"></select>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;">
                            <label class="control-label">@SharedLocalizer["Label_Content"]</label>
                        </td>
                        <td colspan="7">
                            <div class="html-editor" id="content-editor">@Html.Raw(Model.CONTENTS_HTML)</div>
                            <input type="hidden" asp-for="CONTENTS_HTML" />
                        </td>
                    </tr>
                    <!-- <tr>
                        <td style="vertical-align: top;"><label asp-for="NOTE_HTML" class="control-label"></label></td>
                        <td colspan="3">
                            <div id="note-editor">@Html.Raw(Model.NOTE_HTML)</div>
                            <input type="hidden" asp-for="NOTE_HTML" />
                        </td>
                    </tr> -->
                    <tr>
                        <td>@SharedLocalizer["Label_Attachments"]</td>
                        <td colspan="7">
                            @if (Model.AttachFiles.Any())
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var file in Model.AttachFiles)
                                    {
                                        <li class="list-group-item">
                                            <input type="checkbox" name="deletedFiles" value="@file.FILEID" id="del-@file.FILEID" class="form-check-input" />
                                            <label for="del-@file.FILEID" class="form-check-label ms-2">@SharedLocalizer["Button_Delete"]</label>
                                            <a asp-action="DownloadFile" asp-route-id="@file.FILEID" class="ms-3">@file.REAL_FILENAME</a>
                                        </li>
                                    }
                                </ul>
                            }
                            <div>
                                <div id="file-uploader"></div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="button-area text-end mt-5 m-3">
                <input type="submit" value="@SharedLocalizer["Button_Save"]" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.REQID" class="btn btn-secondary">@SharedLocalizer["Button_Cancel"]</a>
                <a asp-action="Index" class="btn btn-list">@SharedLocalizer["Button_List"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        #file-uploader .dx-fileuploader-input-wrapper { min-height: 150px; border: 2px dashed #ccc; padding: 20px; background-color: #f8f9fa; }
        .html-editor .dx-htmleditor-content {
            white-space: normal; /* 텍스트가 자동으로 줄 바꿈되도록 설정 */
            word-break: break-word; /* 긴 단어도 줄 바꿈되도록 설정 */
            background-color:#ffffff;
        }
    </style>
    <script>

        // 메뉴 dropdown function
        const getReqMenuDropdown = function (reqMenuValue, systemCd, adminId){

            var reqMenuDropdown = $('#ReqMenu');

            reqMenuDropdown.empty();
            reqMenuDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectMenu"])'));

            $.ajax({
                url: '@Url.Action("GetMenusBySystemCode", "CommCode")',
                type: 'GET',
                data: { systemCodeId: systemCd },
                success: function(data) {
                    $.each(data, function(i, item) {
                        reqMenuDropdown.append($('<option></option>').val(item.value).text(item.text));
                    });

                    reqMenuDropdown.val(reqMenuValue);      

                    getadminDropdown(adminId, reqMenuValue);
                },
                error: function(xhr, status, error) {
                    console.error("An error occurred while fetching menus: " + error);
                }
            });

        }
        
        // 조치자 dropdown function
        const getadminDropdown = function( adminId, menuId ){
            
            var adminDropdown = $('#RESUSERID');

            adminDropdown.empty();
            adminDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectActionTaker"])'));

            if (menuId) {
                $.ajax({
                    url: '@Url.Action("GetAdminRel", "Req")',
                    type: 'GET',
                    data: { menuId: menuId },
                    success: function(data) {
                        $.each(data, function(i, item) {
                            adminDropdown.append($('<option></option>').val(item.value).text(item.text));
                        });

                        adminDropdown.val(adminId);
                    },
                    error: function(xhr, status, error) {
                        console.error("An error occurred while fetching menus: " + error);
                    }
                });
            }

        }


        $(function() {
            initializeHtmlEditor('#content-editor', 'input[name="@Html.NameFor(m => m.CONTENTS_HTML)"]');
            //initializeHtmlEditor('#note-editor', 'input[name="@Html.NameFor(m => m.NOTE_HTML)"]');

            $("#file-uploader").dxFileUploader({
                name: 'newFiles',
                multiple: true,
                uploadMode: 'useForm'
            });

            var systemcd = $('#SYSTEMCD').val();
            
            // 메뉴 
            if (systemcd) {
                var reqMenuValue = @Html.Raw(Json.Serialize(Model.REQMENU));
                var adminId = @Html.Raw(Json.Serialize(Model.RESUSERID));
                getReqMenuDropdown(reqMenuValue, systemcd, adminId);
            };


            $('#SYSTEMCD').on('change', function() {

                var systemCodeId = $(this).val();
                var reqMenuDropdown = $('#ReqMenu');

                reqMenuDropdown.empty();
                reqMenuDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectMenu"])'));

                if (systemCodeId) {
                    $.ajax({
                        url: '@Url.Action("GetMenusBySystemCode", "CommCode")',
                        type: 'GET',
                        data: { systemCodeId: systemCodeId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                reqMenuDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            $('#ReqMenu').on('change', function() {

                var menuId = $(this).val();                
                var adminDropdown = $('#RESUSERID');

                adminDropdown.empty();
                adminDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectActionTaker"])'));

                if (menuId) {
                    $.ajax({
                        url: '@Url.Action("GetAdminRel", "Req")',
                        type: 'GET',
                        data: { menuId: menuId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                adminDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // "목록" 버튼 클릭 시 저장된 검색 조건이 있으면 해당 주소로 이동
            $('.btn-list').on('click', function (e) {
                var lastSearch = sessionStorage.getItem('reqLastSearch');
                if (lastSearch) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("Index", "Req")' + lastSearch;
                }
            });

        });
    </script>
}
