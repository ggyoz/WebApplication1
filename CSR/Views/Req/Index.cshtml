@model PagedResult<ReqInfo>
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Security.Claims
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = SharedLocalizer["Title_ReqIndex"];
}

<partial name="_PageTitlePartial" />

<div class="search-area card p-3">
    <form asp-action="Index" method="get">
        <div class="row">
            <div class="col-md-10">
                <input type="text" name="searchValue" value="@ViewData["SearchValue"]" class="form-control" placeholder="@SharedLocalizer["Placeholder_SearchByTitle"]" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-light search-btn w-100">@SharedLocalizer["Button_Search"]</button>
            </div>
        </div>
    </form>
</div>

<div class="text-end mb-3">
    <a asp-action="Create" class="btn btn-add">@SharedLocalizer["Button_Create"]</a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>요청번호</th>
                <th>제목</th>
                <th>요청분류</th>
                <th>대상시스템</th>
                <th>요청메뉴</th>
                <th>요청자</th>                
                <th>요청일</th>
                <th>처리기한</th>
                <th>완료예정일</th>
                <th>진행상태</th>
                <th>진행률</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.REQID</td>
                        @{
                            var userDiv = HttpContextAccessor.HttpContext.User.FindFirst(ClaimTypes.Role)?.Value;
                            //var actionName = (userDiv == "R1" || userDiv == "R2") ? "Details" :
                            //                 ((userDiv == "R3" || userDiv == "R4") ? "Answer" : "Details"); 

                            var actionName = "Details";

                        }
                        <td><a asp-action="@actionName" asp-route-id="@item.REQID">@item.TITLE</a></td>
                        <td>@item.ReqTypeName</td>
                        <td>@item.SystemName</td>
                        <td>@item.ReqMenuName</td>
                        <td>@item.ReqUserName</td>
                        <td>@item.REQDATE.ToString("yyyy-MM-dd")</td>
                        <td>@(item.DUEDATE.HasValue ? item.DUEDATE.Value.ToString("yyyy-MM-dd") : "")</td>
                        <td>@(item.EXPECTDATE.HasValue ? item.EXPECTDATE.Value.ToString("yyyy-MM-dd") : "미정")</td>
                        <td>@(item.ProcStatusName != null ? item.ProcStatusName : "대기" )</td>
                        <td>@item.PROC_RATE%</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.REQID" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Button_Edit"]</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">@SharedLocalizer["Message_NoData"]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_PagingPartial" model="Model" />
