@model ReqInfo
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = SharedLocalizer["Title_ReqDetails"];

    // 로그인 계정정보
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<partial name="_PageTitlePartial" />

<div>
    <span class="badge bg-secondary ms-3 me-3"><label>@SharedLocalizer["Label_No"] @Model.REQID</label></span>
    <label>@Model.TITLE</label>
    <hr />
    <div class="row">
        <div class="col-md-12">
            <table class="table-layout Details" style="width:100%">
                <colgroup>
                    <col width="8%"></col>
                    <col width="10%"></col>
                    <col width="8%"></col>
                    <col width="20%"></col>
                    <col width="8%"></col>
                    <col width="20%"></col>
                    <col width="8%"></col>
                    <col width="20%"></col>
                </colgroup>

                <tr>
                    <td><label>@SharedLocalizer["Label_Requester"]</label></td>
                    <td>@Model.ReqUserName</td>
                    <td><label>@SharedLocalizer["Label_Affiliation"]</label></td>
                    <td>@{
                            var orgParts = new[] { Model.CorpName, Model.DeptName, Model.OfficeName, Model.TeamName };
                            var organization = string.Join(" / ", orgParts.Where(p => !string.IsNullOrEmpty(p)));
                        }
                        @organization
                    </td>
                    <td><label>@SharedLocalizer["Label_Email"]</label></td>
                    <td>@Model.ReqUserEmail</td>
                    <td><label>@SharedLocalizer["Label_Contact"]</label></td>
                    <td>@Model.ReqUserTel</td>                    
                </tr>

                <tr>
                    <td><label>@SharedLocalizer["Label_RequestType"]</label></td>
                    <td>@Model.ReqTypeName</td>
                    <td><label>@SharedLocalizer["Label_SystemCode"]</label></td>
                    <td>@Model.SystemName</td>                    
                    <td><label>@SharedLocalizer["Label_RequestMenu"]</label></td>
                    <td>@Model.ReqMenuName</td>
                    <td><label>@SharedLocalizer["Label_ActionTaker"]</label></td>
                    <td>
                        @if ((await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded && Model.PROC_STATUS != "68" )
                        {
                            <form asp-action="UpdateResUser" asp-route-id="@Model.REQID" method="post" class="d-inline-flex align-items-center">
                                @Html.AntiForgeryToken()
                                <select name="resUserId" asp-for="RESUSERID" asp-items="ViewBag.UserList" class="form-select form-select" style="width: auto;">
                                    <option value="">@SharedLocalizer["Placeholder_SelectActionTaker"]</option>
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm ms-2">@SharedLocalizer["Button_Change"]</button>
                            </form>
                        }
                        else
                        {
                            @Model.ResUserName
                        }
                    </td>
                </tr>
                
                <tr>
                    <td><label>@SharedLocalizer["Label_RequestDate"]</label></td>
                    <td>@Model.REQDATE.ToString("yyyy-MM-dd")</td>
                    <td><label>@SharedLocalizer["Label_DueDate"]</label></td>
                    <td>@( Model.DUEDATE.HasValue ? Model.DUEDATE.Value.ToString("yyyy-MM-dd") : SharedLocalizer["Status_Undecided"].Value )</td>
                    <td><label>@SharedLocalizer["Label_ExpectedCompletionDate"]</label></td>
                    <td>
                        @if((await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded && Model.PROC_STATUS != "68" )
                        {
                            <form asp-action="UpdateExpectDate" asp-route-id="@Model.REQID" method="post" class="d-inline-flex align-items-center">
                                @Html.AntiForgeryToken()
                                <div id="ExpectDate"></div>                                
                                <input type="hidden" name="ExpectDate" id="hiddenExpectDate" value="@Model.EXPECTDATE?.ToString("yyyy-MM-dd")" maxlength="10" />                                
                                <button type="submit" onclick="return setExpectDate();" class="btn btn-primary btn-sm ms-2">@SharedLocalizer["Button_Change"]</button>
                            </form>
                            <p id="expectDateError" class="text-danger d-block"></p>
                        }
                        else
                        {
                            @( Model.EXPECTDATE.HasValue ? Model.EXPECTDATE.Value.ToString("yyyy-MM-dd") : SharedLocalizer["Status_Undecided"].Value)
                        }
                    </td>
                    <td><label>@SharedLocalizer["Label_ProgressStatus"]</label></td>
                    <td>@(Model.ProcStatusName != null ? Model.ProcStatusName : SharedLocalizer["Status_Waiting"].Value)</td>
                </tr>
                <tr>
                    <td><label>@SharedLocalizer["Label_Urgency"]</label></td>
                    <td>@Model.PriorityName</td>                                        
                    <td><label>@SharedLocalizer["Label_Tcode"]</label></td>
                    <td>@Model.REQTCODE</td>
                </tr>
                
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">@SharedLocalizer["Label_InquiryContent"]</div>
        <div class="card-body content-display">
            @Html.Raw(Model.CONTENTS_HTML)
        </div>
    </div>

    <hr/> 
    @if((await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded)
    {
    <div class="row">
        <div class="col-md-12">
            <table class="table-layout Details" style="width:100%">
                    <tr >
                        <td><label>@SharedLocalizer["Label_Importance"]</label></td>
                        <td>@SharedLocalizer["CC" + Model.IMPTCD]</td>
                        <td><label>@SharedLocalizer["Label_Difficulty"]</label></td>
                        <td>@SharedLocalizer["CC" + Model.DFCLTCD]</td>
                        <td><label>@SharedLocalizer["Label_ManDay"]</label></td>
                        <td>@Model.MAN_DAY</td>
                        <td><label>@SharedLocalizer["Label_BXTInquiryNo"]</label></td>
                        <td>@Model.BXTID</td>
                        <td><label>@SharedLocalizer["Label_ActionContentTcode"]</label></td>
                        <td>@Model.RESTCODE</td>
                    </tr>
            </table>
        </div>
    </div>   
    <hr/>
    }
    
    @{
        var nonFormStatus = new List<string>{ "63", "65", "68", "69", "82" };
    }
    
    @if((await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded && !nonFormStatus.Contains(Model.PROC_STATUS) ){
    
    // 관리자 권한 & 대기상태가 아닌경우
    <form id="req-form" asp-action="SubmitAnswer" asp-route-id="@Model.REQID" enctype="multipart/form-data">
        <input type="hidden" asp-for="REQID" />
        <input type="hidden" asp-for="PROC_STATUS" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <table class="table-layout" width="100%">
            <colgroup>
                <col width="8%"></col>
                <col width="10%"></col>
                <col width="8%"></col>
                <col width="10%"></col>
                <col width="8%"></col>
                <col width="10%"></col>
                <col width="8%"></col>
                <col width="10%"></col>
                <col width="8%"></col>
                <col width="10%"></col>                
            </colgroup>
            <tbody>
            <tr>
                <td><label>@SharedLocalizer["Label_Difficulty"]</label></td>
                <td>
                    <select asp-for="DFCLTCD" asp-items="ViewBag.difficultCodes" class="form-select" required>
                        <option value="">@SharedLocalizer["Placeholder_SelectDifficulty"]</option>
                    </select>
                    <span asp-validation-for="DFCLTCD" class="text-danger"></span>
                </td>
                <td><label>@SharedLocalizer["Label_Importance"]</label></td>
                <td>
                    <select asp-for="IMPTCD" asp-items="ViewBag.ImportantCodes" class="form-select" required>
                        <option value="">@SharedLocalizer["Placeholder_SelectImportance"]</option>
                    </select>
                    <span asp-validation-for="IMPTCD" class="text-danger"></span>
                </td>
                <td><label>@SharedLocalizer["Label_ManDay"]</label></td>
                <td><input asp-for="MAN_DAY" type="number" step="0.5" class="form-control" min="0" max="100" oninput="enforceMinMaxValue(this)" required/>
                    <span asp-validation-for="MAN_DAY" class="text-danger"></span></td>
                <td><label>@SharedLocalizer["Label_BXTInquiryNo"]</label></td>
                <td><input asp-for="BXTID" type="text" class="form-control" maxlength="10" maxlength="10" />
                    <span asp-validation-for="BXTID" class="text-danger"></span></td>
                <td><label>@SharedLocalizer["Label_Tcode"]</label></td>
                <td><input asp-for="RESTCODE" type="text" class="form-control" maxlength="10" />
                    <span asp-validation-for="RESTCODE" class="text-danger"></span></td>                
            </tr>
            <tr>
                <td style="vertical-align: top;"><label asp-for="ANSWER_HTML" class="control-label"></label></td>
                <td colspan="9">
                    <div id="answer-editor">@Html.Raw(Model.ANSWER_HTML)</div>
                    <input type="hidden" asp-for="ANSWER_HTML" />
                </td>
            </tr>    
            <tr>
                <td style="vertical-align: top;"><label asp-for="NOTE_HTML" class="control-label"></label></td>
                <td colspan="9">
                    <div id="note-editor">@Html.Raw(Model.NOTE_HTML)</div>
                    <input type="hidden" asp-for="NOTE_HTML" />
                </td>
            </tr>
            <tr>
                <td>@SharedLocalizer["Label_Attachments"]</td>
                <td colspan="3">
                    @if (Model.AttachFiles.Any())
                    {
                        <ul class="list-group mb-3">
                            @foreach (var file in Model.AttachFiles)
                            {
                                <li class="list-group-item">
                                    <input type="checkbox" name="deletedFiles" value="@file.FILEID" id="del-@file.FILEID" class="form-check-input" />
                                    <label for="del-@file.FILEID" class="form-check-label ms-2">@SharedLocalizer["Button_Delete"]</label>
                                    <a asp-action="DownloadFile" asp-route-id="@file.FILEID" class="ms-3">@file.REAL_FILENAME</a>
                                </li>
                            }
                        </ul>
                    }
                    <div>
                        <div id="file-uploader"></div>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>

        <div class="button-area text-end mt-5 m-3">
            <button type="submit" class="btn btn-primary">@SharedLocalizer["Button_RegisterAnswer"]</button>
            <button type="button" value="임시저장" class="btn btn-secondary" onclick="saveDraft()" >@SharedLocalizer["Button_SaveDraft"]</button>
        </div>
    </form>

    }

    <!-- 답변완료 시 답변 내용 출력 -->
    @if (!string.IsNullOrEmpty(Model.ANSWER_HTML) && ( Model.PROC_STATUS == "65" || Model.PROC_STATUS == "68" ) )
    {
        <div class="card mt-4">
            <div class="card-header">@Html.DisplayNameFor(model => model.ANSWER_HTML)</div>
            <div class="card-body content-display">
                @Html.Raw(Model.ANSWER_HTML)
            </div>
        </div>
        
        @if((await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded){
            <div class="card mt-4">
                <div class="card-header">@Html.DisplayNameFor(model => model.NOTE_HTML)</div>
                <div class="card-body content-display">
                    @Html.Raw(Model.NOTE_HTML)
                </div>
            </div>
        }

    }

    @if (Model.PROC_STATUS == "65" && Model.REQUSERID == User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier))
    {
        <div class="card mt-4">
            <div class="card-header">
                @SharedLocalizer["Label_ReInquiry"]
            </div>
            <div class="card-body">
                <form asp-action="SubmitReInquiry" asp-controller="Req" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.REQID" />
                    
                    <div class="mb-3">
                        <div id="re-inquiry-editor"></div>
                        <input type="hidden" name="reInquiryContent" />
                    </div>
                    
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">@SharedLocalizer["Button_SendReInquiry"]</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.AttachFiles.Any())
    {
        <div class="card mt-4">
            <div class="card-header">@SharedLocalizer["Label_Attachments"]</div>
            <ul class="list-group list-group-flush">
                @foreach(var file in Model.AttachFiles)
                {
                    <li class="list-group-item">
                        <a asp-action="DownloadFile" asp-route-id="@file.FILEID">@file.REAL_FILENAME</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>


<!-- 히스토리 영역 -->
<div class="mt-4">
    @if (Model.History.Any())
    {
        <ul class="nav nav-tabs" id="historyTab" role="tablist">
            @{ var isFirst = true; }
            @foreach (var hist in Model.History)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(isFirst ? "active" : "")" id="hist-tab-@hist.HISTORYID" data-bs-toggle="tab" data-bs-target="#hist-pane-@hist.HISTORYID" type="button" role="tab" aria-controls="hist-pane-@hist.HISTORYID" aria-selected="@isFirst.ToString().ToLower()">
                        @(!string.IsNullOrEmpty(hist.HISTORY_REASON) ? SharedLocalizer["CC" + hist.HISTORY_REASON] : SharedLocalizer["Label_HistoryPrefix", hist.HISTORYID])
                    </button>
                </li>

                isFirst = false;
                
            }
        </ul>
        <div class="tab-content" id="historyTabContent">
            @{ isFirst = true; }
            @foreach (var hist in Model.History)
            {
                <div class="tab-pane fade @(isFirst ? "show active" : "") p-3" id="hist-pane-@hist.HISTORYID" role="tabpanel" aria-labelledby="hist-tab-@hist.HISTORYID">
                    <div class="card mb-2">
                        <div class="card-header">
                            <div class="justify-content-between mb-1">
                                <span class="card-text1"><strong>@SharedLocalizer["Label_ActionTaker"]:</strong> @hist.ResUserName</span>
                                <span class="card-text1"><strong>@SharedLocalizer["Label_RegistrationDate"]:</strong> @hist.REG_DATE.ToString("yyyy-MM-dd HH:mm")</span>                            
                                <span class="card-text1"><strong>@SharedLocalizer["Label_RequestDate"]:</strong> @hist.REQDATE.ToString("yyyy-MM-dd")</span>
                                <span class="card-text1"><strong>@SharedLocalizer["Label_DueDate"]:</strong> @(hist.DUEDATE.HasValue ? hist.DUEDATE.Value.ToString("yyyy-MM-dd") : SharedLocalizer["Status_Undecided"].Value)</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="content-display">
                                @Html.Raw(hist.CONTENTS_HTML)
                            </div>
                        </div>                        
                    </div>

                    @if(!string.IsNullOrEmpty(hist.HISTORY_REASON)){
                        
                    }

                    @if(hist.ANSWER_HTML != null){

                        <div class="card mb-2 border" style="border-style:soild;border-width:1px;">
                            <div class="card-header">
                                <div class="justify-content-between mb-1">
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_ActionTaker"]:</strong> @hist.ResUserName</span>
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_RegistrationDate"]:</strong> @hist.REG_DATE.ToString("yyyy-MM-dd HH:mm")</span>
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_RequestDate"]:</strong> @hist.REQDATE.ToString("yyyy-MM-dd")</span>
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_DueDate"]:</strong> @(hist.DUEDATE.HasValue ? hist.DUEDATE.Value.ToString("yyyy-MM-dd") : SharedLocalizer["Status_Undecided"].Value)</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="content-display">
                                    @Html.Raw(hist.ANSWER_HTML)
                                </div>
                            </div>
                        </div>

                    }

                    @if(hist.NOTE_HTML != null && (await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded ){

                        <div class="card">
                            <div class="card-header">
                                <div class="justify-content-between mb-1">
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_ActionTaker"]:</strong> @hist.ResUserName</span>
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_RegistrationDate"]:</strong> @hist.REG_DATE.ToString("yyyy-MM-dd HH:mm")</span>                                
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_RequestDate"]:</strong> @hist.REQDATE.ToString("yyyy-MM-dd")</span>
                                    <span class="card-text1"><strong>@SharedLocalizer["Label_DueDate"]:</strong> @(hist.DUEDATE.HasValue ? hist.DUEDATE.Value.ToString("yyyy-MM-dd") : SharedLocalizer["Status_Undecided"].Value)</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="content-display">
                                    @Html.Raw(hist.NOTE_HTML)
                                </div>
                            </div>                        
                        </div>

                    }                    

                </div>

                isFirst = false;
                
            }
            
        </div>
    }
    else
    {
        <p>@SharedLocalizer["Message_NoHistory"]</p>
    }
</div>
<!-- 히스토리 영역 -->

<!-- 버튼 영역 -->
<div class="d-flex justify-content-between align-items-center mt-5">
    <div>
        @if(Model.PROC_STATUS == "69")
        {
            <form asp-action="Delete" asp-route-id="@Model.REQID" method="post" onsubmit="return confirm('@SharedLocalizer["Confirmation_Delete"]');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    @SharedLocalizer["Button_Delete"]
                </button>
            </form>
        }
    </div>

    <div class="d-flex justify-content-center flex-grow-1">
        @if ((await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded && Model.PROC_STATUS == "69")
        {
            <form asp-controller="Req" asp-action="SetProcStatus" asp-route-id="@Model.REQID" method="post" class="me-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="62" />
                <button type="submit" class="btn btn-primary">@SharedLocalizer["Button_Accept"]</button>
            </form>
            <form asp-controller="Req" asp-action="SetProcStatus" asp-route-id="@Model.REQID" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="63" />
                <button type="submit" class="btn btn btn-secondary">@SharedLocalizer["Button_Reject"]</button>
            </form>
        }

        @if( (Model.PROC_STATUS == "65" && currentUserId == Model.REQUSERID) || Model.PROC_STATUS == "65" && (await AuthorizationService.AuthorizeAsync(User, "RequireManagerOrHigher")).Succeeded){

            // 종결
            <form asp-controller="Req" asp-action="SetProcStatus" asp-route-id="@Model.REQID" method="post" onsubmit="return confirm('@SharedLocalizer["Confirmation_Terminate"]');" class="me-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="68" />
                <button type="submit" class="btn btn-warning">@SharedLocalizer["Button_Terminate"]</button>
            </form>
            
        }
    </div>

    <div>
        @if(Model.PROC_STATUS == "69" && currentUserId == Model.REQUSERID)
        {
            <a asp-action="Edit" asp-route-id="@Model.REQID" class="btn btn-primary">@SharedLocalizer["Button_Edit"]</a>
        }
        <a asp-action="Index" class="btn btn-list">@SharedLocalizer["Button_List"]</a>
    </div>
</div>
<!-- 버튼 영역 -->

@section Scripts {

<style>

    .card-text1{
        background-color:#dbe3e8;        
        border-radius: 10rem;
        line-height: 1;
        padding: .4em 1em .4em 1em;
        display: inline-block;
        text-align: center;
        vertical-align: middle;
    }

    .dx-texteditor-container{
        height: 28px;
        font-size: 14px;
        align-items: center;
    }
    .table-layout.Details td {
        padding: 8px 12px;
    }
    .table-layout.Details label {
        font-weight: bold;
    }
    .dx-htmleditor-content {
        white-space: normal; /* 텍스트가 자동으로 줄 바꿈되도록 설정 */
        word-break: break-word; /* 긴 단어도 줄 바꿈되도록 설정 */
        background-color:#ffffff;
    }
    
</style>

<script>

    const oriExpectDate = '@(Model.EXPECTDATE?.ToString("yyyy-MM-dd"))';    

    initDateBox('#ExpectDate', '#hiddenExpectDate', '@(Model.EXPECTDATE?.ToString("yyyy-MM-dd"))');

    initializeHtmlEditor('#answer-editor', 'input[name="@Html.NameFor(m => m.ANSWER_HTML)"]');
    initializeHtmlEditor('#note-editor', 'input[name="@Html.NameFor(m => m.NOTE_HTML)"]');
    initializeHtmlEditor('#re-inquiry-editor', 'input[name="reInquiryContent"]');

    function saveDraft() {
        var form = document.getElementById('req-form');
        form.action = '@Url.Action("SaveDraft", "Req", new { id = Model.REQID })';
        form.submit();
    }

    function setExpectDate(){
        var expectDateValue = $('#hiddenExpectDate').val();
        var expectDateErrorSpan = $('#expectDateError');
        var requestDateStr = '@Model.REQDATE.ToString("yyyy-MM-dd")';
        expectDateErrorSpan.text(''); 

        if (!expectDateValue) {
            expectDateErrorSpan.text('@Html.Raw(SharedLocalizer["Validation_SelectExpectDate"])');
            return false;
        }

        if(oriExpectDate == expectDateValue){
            expectDateErrorSpan.text('@Html.Raw(SharedLocalizer["Validation_SameExpectDate"])');
            return false;
        }

        var requestDate = new Date(requestDateStr);
        var selectedExpectDate = new Date(expectDateValue);

        // Set hours/minutes/seconds to 0 for accurate date comparison
        requestDate.setHours(0, 0, 0, 0);
        selectedExpectDate.setHours(0, 0, 0, 0);

        // Validate: Expected End Date must be after Request Date
        if (selectedExpectDate <= requestDate) {
            expectDateErrorSpan.text('@Html.Raw(SharedLocalizer["Validation_ExpectDateAfterRequestDate_Part1"])' + requestDateStr + '@Html.Raw(SharedLocalizer["Validation_ExpectDateAfterRequestDate_Part2"])');
            return false;
        }

        return true; // All validations passed, allow form submission
    }
    
</script>

}