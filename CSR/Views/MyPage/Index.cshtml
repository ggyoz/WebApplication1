@model CSR.Models.User
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<CSR.SharedStrings> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["MyPageTitle"];
}

<partial name="_PageTitlePartial" />

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="UserId" /> 
            <input type="hidden" asp-for="RegDate" /> 
            <input type="hidden" asp-for="RegUserId" />            
            <input type="hidden" asp-for="EmpNo" />
            <input type="hidden" asp-for="SysCd" />
            <input type="hidden" asp-for="BizCd" />
            <input type="hidden" asp-for="CustCd" />
            <input type="hidden" asp-for="VendCd" />
            <input type="hidden" asp-for="UserStat" />
            <input type="hidden" asp-for="RetireDate" />
            <input type="hidden" asp-for="AdminFlag" />
            <input type="hidden" asp-for="AuthFlag" />
            <input type="hidden" asp-for="UserDiv" />
            <input type="hidden" asp-for="PwMissCount" />
            <input type="hidden" asp-for="UseYn" />
            <input type="hidden" asp-for="UpdateDate" />
            <input type="hidden" asp-for="UpdateUserId" />
            <input type="hidden" asp-for="CorCd"/>
            <input type="hidden" asp-for="DeptCd"/>
            <input type="hidden" asp-for="OfficeCd"/>
            <input type="hidden" asp-for="TeamCd"/>

            <table class="table-layout" width="100%">
                <colgroup>
                    <col width="7%" />
                    <col width="15%" />
                    <col width="7%" />
                    <col width="15%" />
                    <col width="7%" />
                    <col width="15%" />
                    <col width="7%" />
                    <col width="15%" />
                </colgroup>
                <tr>
                    <td><label asp-for="UserId" class="control-label">@SharedLocalizer["Label_UserId"]</label></td>
                    <td>
                        <input asp-for="UserId" class="form-control" readonly />
                    </td>
                    <td><label asp-for="UserName" class="control-label">@SharedLocalizer["Label_UserName"] *</label></td>
                    <td>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </td>
                </tr>
                <tr>
                    <td>@SharedLocalizer["Label_Corporation"]</td>                    
                    <td>
                        <select asp-for="CorCd" id="CorCd" asp-items="ViewBag.CorCdList" class="form-select" disabled >
                            <option value="">@SharedLocalizer["Placeholder_SelectCorporation"]</option>
                        </select>
                        <span asp-validation-for="CorCd" class="text-danger"></span>
                    </td>
                    <td>@SharedLocalizer["Label_Department"]</td>
                    <td>
                        <select asp-for="DeptCd" id="DeptCd" asp-items="ViewBag.DeptCdList"  class="form-select" disabled>
                            <option value="">@SharedLocalizer["Placeholder_SelectDepartment"]</option>
                        </select>
                        <span asp-validation-for="DeptCd" class="text-danger"></span>
                    </td>
                    <td>@SharedLocalizer["Label_Office"]</td>
                    <td>
                        <select asp-for="OfficeCd" id="OfficeCd" asp-items="ViewBag.OfficeCdList" class="form-select" disabled>
                            <option value="">@SharedLocalizer["Placeholder_SelectOffice"]</option>
                        </select>
                        <span asp-validation-for="OfficeCd" class="text-danger"></span>
                    </td>
                    <td>@SharedLocalizer["Label_Team"]</td>
                    <td>
                        <select asp-for="TeamCd" id="TeamCd" asp-items="ViewBag.TeamCdList" class="form-select" disabled>
                            <option value="">@SharedLocalizer["Placeholder_SelectTeam"]</option>
                        </select>
                        <span asp-validation-for="TeamCd" class="text-danger"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="TelNo" class="control-label">@SharedLocalizer["Label_PhoneNumber"]</label></td>
                    <td>
                        <input asp-for="TelNo" class="form-control" oninput="this.value=formatPhoneNumber(this.value)" maxlength="13" />
                        <span asp-validation-for="TelNo" class="text-danger"></span>
                    </td>
                    <td><label asp-for="MobPhoneNo" class="control-label">@SharedLocalizer["Label_MobilePhoneNumber"]</label></td>
                    <td>
                        <input asp-for="MobPhoneNo" class="form-control" oninput="this.value=formatPhoneNumber(this.value)" maxlength="13" />
                        <span asp-validation-for="MobPhoneNo" class="text-danger"></span>
                    </td>
                    <td><label asp-for="EmailAddr" class="control-label">@SharedLocalizer["Label_EmailAddress"]</label></td>
                    <td colspan="3">
                        <input asp-for="EmailAddr" class="form-control" type="email" />
                        <span asp-validation-for="EmailAddr" class="text-danger"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="UserPwd" class="control-label">@SharedLocalizer["Label_Password"]</label></td>
                    <td>
                        <input asp-for="UserPwd" id="UserPwd" class="form-control" type="password" placeholder="@SharedLocalizer["Placeholder_PasswordChange"]" autocomplete="new-password" />
                        <span asp-validation-for="UserPwd" class="text-danger"></span>
                        <small class="form-text text-muted">@SharedLocalizer["Help_PasswordChange"]</small>
                    </td>
                </tr>
                <tr>
                    <td><label class="control-label">@SharedLocalizer["Label_ConfirmPassword"]</label></td>
                    <td>
                        <input id="ConfirmPassword" name="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                        <span id="ConfirmPasswordValidation" class="text-danger"></span>
                    </td>
                </tr>

            </table>

            <div class="button-area text-end mt-5 m-3">
                <input type="submit" value="@SharedLocalizer["Button_Save"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

    

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @if (ViewBag.ShowSuccessAlert != null && (bool)ViewBag.ShowSuccessAlert) {

            <script type="text/javascript">

                const logoutUrl = '@Url.Action("Logout", "Account")';

                function forceLogout() {
                    window.location.href = logoutUrl;                    
                }

                $(document).ready(function() {
                    var message = @Html.Raw(Json.Serialize(SharedLocalizer["Message_ProfileUpdateSuccess"].Value));
                    alert(message);
                    forceLogout();
                });                 
            </script>
        }

    <script>
        function formatPhoneNumber(input) {
            // Remove all non-digit characters
            var cleaned = ('' + input).replace(/\D/g, '');
            var match;

            // Check if it's a mobile number (010, 011, etc.)
            if (cleaned.startsWith('01')) {
                // If 10 or 11 digits (e.g., 010-1234-5678, 011-123-4567)
                if (cleaned.length < 4) { // 01X
                    return cleaned;
                } else if (cleaned.length < 7) { // 01X-XXX
                    match = cleaned.match(/^(\d{3})(\d{1,3})$/);
                    if (match) return match[1] + '-' + match[2];
                } else if (cleaned.length < 11) { // 01X-XXX-XXXX or 01X-XXXX-XXXX
                    match = cleaned.match(/^(\d{3})(\d{3,4})(\d{1,4})$/);
                    if (match) return match[1] + '-' + match[2] + '-' + match[3];
                } else { // Full 11 digits
                    match = cleaned.match(/^(\d{3})(\d{4})(\d{4})$/);
                    if (match) return match[1] + '-' + match[2] + '-' + match[3];
                }
            } else {
                // General phone numbers (e.g., area codes like 02, 031, or 070, 050X numbers)
                if (cleaned.length < 3) { // 02, 03X
                    return cleaned;
                } else if (cleaned.length < 6) { // 02-XXX, 031-XXX
                    match = cleaned.match(/^(\d{2,3})(\d{1,4})$/);
                    if (match) return match[1] + '-' + match[2];
                } else if (cleaned.length < 10) { // 02-XXX-XXXX, 031-XXX-XXXX
                    match = cleaned.match(/^(\d{2,3})(\d{3,4})(\d{1,4})$/);
                    if (match) return match[1] + '-' + match[2] + '-' + match[3];
                } else { // Full length
                    match = cleaned.match(/^(\d{2,3})(\d{3,4})(\d{4})$/);
                    if (match) return match[1] + '-' + match[2] + '-' + match[3];
                }
            }
            return input; // Return original if no match or not enough digits
        }

         $(function () {     

            var DeptCdVal = @Html.Raw(Json.Serialize(Model.DeptCd));
            var OfficeCdVal = @Html.Raw(Json.Serialize(Model.OfficeCd));
            var TeamCdVal = @Html.Raw(Json.Serialize(Model.TeamCd));

        // 법인 선택 시 메뉴 드롭다운 변경
            $('#CorCd').on('change', function() {
                var corCd = $(this).val();
                var deptDropdown = $('#DeptCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectDepartment"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd: corCd, deptCd : "" },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // 법인 선택 시 메뉴 드롭다운 변경
            $('#DeptCd').on('change', function() {
                var deptCd = $(this).val();
                var corCd = $('#CorCd').val();

                var deptDropdown = $('#OfficeCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectOffice"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd : corCd, deptCd: deptCd },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });
            
            // 법인 선택 시 메뉴 드롭다운 변경
            $('#OfficeCd').on('change', function() {
                var deptCd = $(this).val();
                var corCd = $('#CorCd').val();

                var deptDropdown = $('#TeamCd');

                deptDropdown.empty();
                deptDropdown.append($('<option></option>').val('').text('@Html.Raw(SharedLocalizer["Placeholder_SelectTeam"])'));

                if (corCd) {
                    $.ajax({
                        url: '@Url.Action("GetCorpbyDeptCode", "Dept")',
                        type: 'GET',
                        data: { corCd : corCd, deptCd: deptCd },
                        success: function(data) {                            
                            $.each(data, function(i, item) {
                                
                                deptDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("An error occurred while fetching menus: " + error);
                        }
                    });
                }
            });

            // Password confirmation logic
            function validatePassword() {
                var password = $('#UserPwd').val();
                var confirmPassword = $('#ConfirmPassword').val();
                var validationSpan = $('#ConfirmPasswordValidation');
                var submitButton = $('input[type="submit"]');

                if (password && confirmPassword && password !== confirmPassword) {
                    validationSpan.text('@Html.Raw(SharedLocalizer["Validation_PasswordMismatch"])'); // New localization key needed
                    submitButton.prop('disabled', true);
                } else {

                    if( _.isEmpty(confirmPassword) ) {
                        validationSpan.text('@Html.Raw(SharedLocalizer["Validation_PasswordMismatch"])'); // New localization key needed
                        submitButton.prop('disabled', true);
                    }else{
                        validationSpan.text('');
                        submitButton.prop('disabled', false);
                    }
                    
                }

                // If password is empty, no need to validate confirm password
                if (!password) {
                    validationSpan.text('');
                    submitButton.prop('disabled', false);
                }
            }

            $('#UserPwd, #ConfirmPassword').on('keyup', validatePassword);

            $('form').on('submit', function(e) {

                // 필수 입력 체크
                var userName = $('#UserName').val();
                var corCd = $('#CorCd').val();
                var deptCd = $('#DeptCd').val();
                var officeCd = $('#OfficeCd').val();
                var teamCd = $('#TeamCd').val();

                if (!userName) {
                    alert("@Html.Raw(SharedLocalizer["Label_UserName"]) @Html.Raw(SharedLocalizer["Validation_Required"])");
                    $('#UserName').focus();
                    e.preventDefault();
                    return false;
                }
                if (!corCd) {
                    alert("@Html.Raw(SharedLocalizer["Label_Corporation"]) @Html.Raw(SharedLocalizer["Validation_Required"])");
                    $('#CorCd').focus();
                    e.preventDefault();
                    return false;
                }
                if (!deptCd) {
                    alert("@Html.Raw(SharedLocalizer["Label_Department"]) @Html.Raw(SharedLocalizer["Validation_Required"])");
                    $('#DeptCd').focus();
                    e.preventDefault();
                    return false;
                }
                if (!officeCd) {
                    alert("@Html.Raw(SharedLocalizer["Label_Office"]) @Html.Raw(SharedLocalizer["Validation_Required"])");
                    $('#OfficeCd').focus();
                    e.preventDefault();
                    return false;
                }
                if (!teamCd) {
                    alert("@Html.Raw(SharedLocalizer["Label_Team"]) @Html.Raw(SharedLocalizer["Validation_Required"])");
                    $('#TeamCd').focus();
                    e.preventDefault();
                    return false;
                }

                var password = $('#UserPwd').val();
                var confirmPassword = $('#ConfirmPassword').val();

                if (password && password !== confirmPassword) {
                    e.preventDefault(); // Prevent form submission
                    validatePassword(); // Show error message if not already shown
                    alert("@Html.Raw(SharedLocalizer["Validation_PasswordMismatch"])");
                }

            });

        });
        
                    
        
            </script>
        }
